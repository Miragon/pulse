{
  "name": "@miragon/pulse-c8-core",
  "version": "0.32.0",
  "description": "The core of the Camunda 8 dialect family (the Orchestration Cluster REST API, from 8.9 on, read-only): C8Runtime, which answers the engine contract of @miragon/pulse-engine-core and decides each failure's kind (C8Failures), over the REST client with its checked views and a transport port that carries fields only (CamundaTransport, CamundaFailure), with the readers and the mappings onto the contract's read models. Each surface brings its own wire and words its own failures. Its one runtime dependency is @miragon/pulse-engine-core.",
  "license": "MIT",
  "keywords": [
    "camunda",
    "camunda8",
    "zeebe",
    "bpmn",
    "workflow"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/connectors/c8/c8-core#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/connectors/c8/c8-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "dependencies": {
    "@miragon/pulse-engine-core": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
