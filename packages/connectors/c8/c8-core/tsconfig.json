{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    // No DOM and no Node types: the C8 adapter runs these reads in the editor hosts, over a wire
    // it brings, so `document` and `process` stay compile errors here.
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [],
    "composite": false,
    "outDir": "dist",
    "rootDir": "src",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
