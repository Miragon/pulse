{
  "name": "@miragon/pulse-analytics-client",
  "version": "0.26.0",
  "description": "Prometheus client and PromQL query functions for Camunda process analytics, with the metrics contract.",
  "license": "MIT",
  "keywords": [
    "camunda",
    "prometheus",
    "promql",
    "process-analytics",
    "metrics",
    "mcp"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/connectors/analytics/analytics-client#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/connectors/analytics/analytics-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-support.*",
    "!dist/**/test-support",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json",
    "metrics-contract.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
