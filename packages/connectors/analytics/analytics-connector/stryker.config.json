{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["./node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"],
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "mutate": [
    "src/bpmn-name-lookup.ts",
    "src/bpmn-names.ts",
    "src/engine-ids.ts",
    "src/named-views.ts",
    "src/server-locale.ts",
    "src/settings-tools.ts",
    "src/settings.ts",
    "src/toolsets.ts",
    "src/tools/engine-compare.ts",
    "src/tools/engine-landscape.ts",
    "src/tools/health.ts",
    "src/tools/performance.ts",
    "src/tools/version-compare.ts"
  ],
  "inPlace": true,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation-report.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 42
  }
}
