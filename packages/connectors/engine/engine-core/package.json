{
  "name": "@miragon/pulse-engine-core",
  "version": "0.28.0",
  "description": "The neutral core of the engine family of Pulse: the contract every dialect implements (the read and write ports ProcessRuntime and ProcessCommands, their ids, read models, queries and failure kinds, and RootCauses, the root-cause rule of every dialect), and in ./testing the conformance kit with its laws, its fixed world and an in-memory fake engine. No runtime dependency.",
  "license": "MIT",
  "keywords": [
    "bpmn",
    "process engine",
    "contract",
    "ports",
    "conformance",
    "workflow"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/connectors/engine/engine-core#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/connectors/engine/engine-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
