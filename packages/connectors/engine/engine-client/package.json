{
  "name": "@miragon/pulse-engine-client",
  "version": "0.26.0",
  "description": "Generated CIB seven / Camunda 7 REST SDK, its client with deadlines and engine errors, and the reads whose REST contract the SDK defaults miss.",
  "license": "MIT",
  "keywords": [
    "camunda",
    "camunda7",
    "cib-seven",
    "bpmn",
    "rest-client",
    "sdk"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/connectors/engine/engine-client#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/connectors/engine/engine-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-support.*",
    "!dist/**/test-support"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/generated/sdk.gen.d.ts",
      "import": "./dist/generated/sdk.gen.js"
    },
    "./types": {
      "types": "./dist/generated/types.gen.d.ts",
      "import": "./dist/generated/types.gen.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "generate": "openapi-ts",
    "spec:refresh": "sh ./scripts/refresh-spec.sh"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
