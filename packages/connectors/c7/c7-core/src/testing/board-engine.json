      "answer": {
        "id": "pulse-order:2:178638c6-e1ad-11f1-99ba-be7fd0075b83",
        "bpmn20Xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:camunda=\"http://camunda.org/schema/1.0/bpmn\" xmlns:modeler=\"http://camunda.org/schema/modeler/1.0\" id=\"Definitions_OrderFulfillment\" targetNamespace=\"http://bpmn.io/schema/bpmn\" modeler:executionPlatform=\"Camunda Platform\" modeler:executionPlatformVersion=\"7.24.0\">\n  <bpmn:process id=\"pulse-order\" name=\"Order fulfillment\" isExecutable=\"true\" camunda:historyTimeToLive=\"180\">\n    <bpmn:startEvent id=\"Event_OrderReceived\" name=\"Order received\">\n      <bpmn:outgoing>Flow_OrderReceivedToRoute</bpmn:outgoing>\n    </bpmn:startEvent>\n    <bpmn:exclusiveGateway id=\"Gateway_Route\" name=\"Route?\" default=\"Flow_RouteToShippedExpress\">\n      <bpmn:incoming>Flow_OrderReceivedToRoute</bpmn:incoming>\n      <bpmn:outgoing>Flow_RouteToReviewOrder</bpmn:outgoing>\n      <bpmn:outgoing>Flow_RouteToChargePayment</bpmn:outgoing>\n      <bpmn:outgoing>Flow_RouteToShippedExpress</bpmn:outgoing>\n    </bpmn:exclusiveGateway>\n    <bpmn:userTask id=\"Activity_ReviewOrder\" name=\"Review order\" camunda:assignee=\"demo\">\n      <bpmn:incoming>Flow_RouteToReviewOrder</bpmn:incoming>\n      <bpmn:outgoing>Flow_ReviewOrderToOrderReviewed</bpmn:outgoing>\n    </bpmn:userTask>\n    <bpmn:endEvent id=\"Event_OrderReviewed\" name=\"Order reviewed\">\n      <bpmn:incoming>Flow_ReviewOrderToOrderReviewed</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_ReviewOrderToOrderReviewed\" sourceRef=\"Activity_ReviewOrder\" targetRef=\"Event_OrderReviewed\" />\n    <bpmn:sequenceFlow id=\"Flow_RouteToReviewOrder\" name=\"review\" sourceRef=\"Gateway_Route\" targetRef=\"Activity_ReviewOrder\">\n      <bpmn:conditionExpression xsi:type=\"bpmn:tFormalExpression\">${route == 'review'}</bpmn:conditionExpression>\n    </bpmn:sequenceFlow>\n    <bpmn:serviceTask id=\"Activity_ChargePayment\" name=\"Charge payment\" camunda:asyncBefore=\"true\" camunda:expression=\"${paymentService.charge(amount)}\">\n      <bpmn:incoming>Flow_RouteToChargePayment</bpmn:incoming>\n      <bpmn:outgoing>Flow_ChargePaymentToPaymentCharged</bpmn:outgoing>\n    </bpmn:serviceTask>\n    <bpmn:endEvent id=\"Event_PaymentCharged\" name=\"Payment charged\">\n      <bpmn:incoming>Flow_ChargePaymentToPaymentCharged</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_ChargePaymentToPaymentCharged\" sourceRef=\"Activity_ChargePayment\" targetRef=\"Event_PaymentCharged\" />\n    <bpmn:sequenceFlow id=\"Flow_RouteToChargePayment\" name=\"charge\" sourceRef=\"Gateway_Route\" targetRef=\"Activity_ChargePayment\">\n      <bpmn:conditionExpression xsi:type=\"bpmn:tFormalExpression\">${route == 'charge'}</bpmn:conditionExpression>\n    </bpmn:sequenceFlow>\n    <bpmn:endEvent id=\"Event_ShippedExpress\" name=\"Shipped express\">\n      <bpmn:incoming>Flow_RouteToShippedExpress</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_RouteToShippedExpress\" name=\"express\" sourceRef=\"Gateway_Route\" targetRef=\"Event_ShippedExpress\" />\n    <bpmn:sequenceFlow id=\"Flow_OrderReceivedToRoute\" sourceRef=\"Event_OrderReceived\" targetRef=\"Gateway_Route\" />\n  </bpmn:process>\n  <bpmndi:BPMNDiagram id=\"BPMNDiagram_pulse-order\">\n    <bpmndi:BPMNPlane id=\"BPMNPlane_pulse-order\" bpmnElement=\"pulse-order\">\n      <bpmndi:BPMNShape id=\"BPMNShape_Event_OrderReceived\" bpmnElement=\"Event_OrderReceived\">\n        <dc:Bounds x=\"80\" y=\"102\" width=\"36\" height=\"36\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"64\" y=\"144\" width=\"68\" height=\"28\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"BPMNShape_Gateway_Route\" bpmnElement=\"Gateway_Route\" isMarkerVisible=\"true\">\n        <dc:Bounds x=\"176\" y=\"95\" width=\"50\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"174\" y=\"75\" width=\"54\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"BPMNShape_Activity_ReviewOrder\" bpmnElement=\"Activity_ReviewOrder\">\n        <dc:Bounds x=\"303\" y=\"80\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"BPMNShape_Event_OrderReviewed\" bpmnElement=\"Event_OrderReviewed\">\n        <dc:Bounds x=\"463\" y=\"102\" width=\"36\" height=\"36\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"447\" y=\"144\" width=\"68\" height=\"28\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"BPMNShape_Activity_ChargePayment\" bpmnElement=\"Activity_ChargePayment\">\n        <dc:Bounds x=\"303\" y=\"220\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"BPMNShape_Event_PaymentCharged\" bpmnElement=\"Event_PaymentCharged\">\n        <dc:Bounds x=\"463\" y=\"242\" width=\"36\" height=\"36\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"451\" y=\"284\" width=\"61\" height=\"28\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"BPMNShape_Event_ShippedExpress\" bpmnElement=\"Event_ShippedExpress\">\n        <dc:Bounds x=\"335\" y=\"360\" width=\"36\" height=\"36\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"323\" y=\"402\" width=\"61\" height=\"28\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNEdge id=\"BPMNEdge_Flow_ReviewOrderToOrderReviewed\" bpmnElement=\"Flow_ReviewOrderToOrderReviewed\">\n        <di:waypoint x=\"403\" y=\"120\" />\n        <di:waypoint x=\"463\" y=\"120\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"BPMNEdge_Flow_RouteToReviewOrder\" bpmnElement=\"Flow_