{
  "name": "@miragon/pulse-c7-core",
  "version": "0.27.1",
  "description": "The core of the Camunda 7 REST dialect family (Operaton, CIB seven, Camunda 7), its workflow domain: the engine port, instance selection, the inspect view, the status triage, the root cause of an incident and the plans of retry and advance, the pure engine REST rules (dates, filters, sorting, variable writes, incident recovery) and the route of each REST operation (method, path, effect), generated from one spec. Its one runtime dependency is @miragon/pulse-engine-core, whose root-cause rule it applies.",
  "license": "MIT",
  "keywords": [
    "camunda",
    "camunda7",
    "operaton",
    "cibseven",
    "bpmn",
    "workflow"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/connectors/c7/c7-core#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/connectors/c7/c7-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "generate": "tsx scripts/generate-routes.ts"
  },
  "dependencies": {
    "@miragon/pulse-engine-core": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
