      },
      "sent": [
        "GET /engine-rest/telemetry/data"
      ]
    },
    {
      "call": "getInstanceDetail pi-1",
      "outcome": {
        "failure": "misconfigured",
        "hint": "Pulse never follows a redirect: point the engine URL at the REST API root itself (https:// if the engine redirects from http://). A redirect to a login page means the credentials are missing or expired.",
        "message": "HTTP 302 Found: redirects to https://sso.example.com/realms/ops/protocol/openid-connect/auth"
      },
      "sent": [
        "GET /engine-rest/history/activity-instance?processInstanceId=pi-1&sortBy=occurrence&sortOrder=asc&firstResult=0&maxResults=500",
        "GET /engine-rest/history/process-instance/pi-1",
        "GET /engine-rest/process-instance/pi-1",
