<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_DispatchOrder" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="pulse-dispatch" name="Dispatch order" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Event_DispatchRequested" name="Dispatch requested">
      <bpmn:outgoing>Flow_DispatchRequestedToPrintShippingLabel</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="Activity_PrintShippingLabel" name="Print shipping label" calledElement="pulse-label">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DispatchRequestedToPrintShippingLabel</bpmn:incoming>
      <bpmn:outgoing>Flow_PrintShippingLabelToOrderDispatched</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="Event_OrderDispatched" name="Order dispatched">
      <bpmn:incoming>Flow_PrintShippingLabelToOrderDispatched</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PrintShippingLabelToOrderDispatched" sourceRef="Activity_PrintShippingLabel" targetRef="Event_OrderDispatched" />
    <bpmn:sequenceFlow id="Flow_DispatchRequestedToPrintShippingLabel" sourceRef="Event_DispatchRequested" targetRef="Activity_PrintShippingLabel" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pulse-dispatch">
    <bpmndi:BPMNPlane id="BPMNPlane_pulse-dispatch" bpmnElement="pulse-dispatch">
      <bpmndi:BPMNShape id="BPMNShape_Event_DispatchRequested" bpmnElement="Event_DispatchRequested">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="61" y="144" width="75" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_PrintShippingLabel" bpmnElement="Activity_PrintShippingLabel">
        <dc:Bounds x="176" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_OrderDispatched" bpmnElement="Event_OrderDispatched">
        <dc:Bounds x="336" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="313" y="144" width="82" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_PrintShippingLabelToOrderDispatched" bpmnElement="Flow_PrintShippingLabelToOrderDispatched">
        <di:waypoint x="276" y="120" />
        <di:waypoint x="336" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_DispatchRequestedToPrintShippingLabel" bpmnElement="Flow_DispatchRequestedToPrintShippingLabel">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="176" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
