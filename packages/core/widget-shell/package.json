  "description": "Shared widget kit for Pulse MCP Apps: UI primitives, view + data-feed builders, and the shell:* widget catalogue.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-apps",
    "widgets",
    "react",
    "ui",
    "camunda"
