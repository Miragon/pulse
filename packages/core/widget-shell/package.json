{
  "name": "@miragon/pulse-widget-shell",
  "version": "0.34.0",
  "description": "The Pulse view runtime and server boot: mountViews, the view host, the query hooks and TestViewHost, a page's section reads and a Claude artifact's mount, view and data-feed builders, the composed-server boot, the tool registrar and server i18n. Its UI builds on @miragon/pulse-ui.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-apps",
    "widgets",
    "react",
    "ui",
    "camunda"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/core/widget-shell#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/core/widget-shell"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-support.*",
    "!dist/**/test-support",
    "THIRD_PARTY_LICENSES.txt",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./widgets": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./claude-artifact": {
      "types": "./dist/ui/claude-artifact/index.d.ts",
      "import": "./dist/ui/claude-artifact/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/oidc": {
      "types": "./dist/testing/oidc/index.d.ts",
      "import": "./dist/testing/oidc/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.widgets.json --noEmit false && node scripts/browser-bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.widgets.json && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "third-party-licenses": "THIRD_PARTY_LICENSES_UPDATE=1 vitest run test/third-party-licenses.test.ts --coverage.enabled=false"
  },
  "peerDependencies": {
    "@miragon/pulse-ui": "workspace:^",
    "@tanstack/react-query": "^5.103.2",
    "lucide-react": "^0.562.0 || ^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "@miragon/pulse-ui": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miragon/pulse-ui": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tanstack/react-query": "5.108.4",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "lucide-react": "1.79.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.1.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@miragon/pulse-http": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.22",
    "jose": "6.2.18",
    "prom-client": "15.1.3"
  }
}
