{
  "name": "@miragon/pulse-board",
  "version": "0.35.0",
  "description": "The board file format of Pulse and its builder: the types of a board, a parser that takes the text of a .board.json file and returns the board with its notes and refused widgets or the problems of a file that gives no board, each a code with its JSON path, the vocabulary of its widgets, filters and columns, a starter board, the JSON Schema for editors, the shared fixtures and the types of a built board's JSON form, and in ./builder the board's numbers over the seven reads of the engine contract and the one serializer into that form. The format has no runtime dependency; ./builder needs @miragon/pulse-engine-core, an optional peer.",
  "license": "MIT",
  "keywords": [
    "bpmn",
    "process engine",
    "board",
    "dashboard",
    "json",
    "workflow"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/core/board#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/core/board"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "schema",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js"
    },
    "./schema/board.schema.json": "./schema/board.schema.json",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "peerDependencies": {
    "@miragon/pulse-engine-core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@miragon/pulse-engine-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miragon/pulse-engine-core": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
