  {
    "name": "starter-board",
    "about": "The starter board both editors write, with the engines they know.",
    "file": {
      "schemaVersion": 1,
      "title": "Shop",
      "engines": ["shop-dev", "shop-test"],
      "rows": [
        {
          "row": [
            { "widget": "counter", "props": { "title": "Running", "filter": {} } },
            {
              "widget": "counter",
              "props": { "title": "With incident", "filter": { "withIncident": true } }
            },
            { "widget": "incidentSummary", "props": { "title": "With incident per process" } }
          ]
        },
        { "row": [{ "widget": "instanceList", "props": { "filter": {} } }] }
      ]
    },
    "schema": true,
    "verdict": {
      "board": {
        "title": "Shop",
        "engines": ["shop-dev", "shop-test"],
        "rows": [
          [
            {
              "widget": "counter",
              "engines": ["shop-dev", "shop-test"],
              "title": "Running",
              "filter": { "state": "running" }
            },
            {
              "widget": "counter",
              "engines": ["shop-dev", "shop-test"],
              "title": "With incident",
              "filter": { "state": "running", "withIncident": true }
            },
            {
              "widget": "incidentSummary",
              "engines": ["shop-dev", "shop-test"],
              "title": "With incident per process",
              "groupBy": "process"
            }
          ],
          [
            {
              "widget": "instanceList",
              "engines": ["shop-dev", "shop-test"],
              "filter": { "state": "running" },
              "columns": ["businessKey", "process", "state", "startedAt"]
            }
          ]
        ]
      }
    }
  },
