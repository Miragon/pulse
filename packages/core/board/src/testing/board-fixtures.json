  {
    "name": "every-widget",
    "about": "Every widget with every prop it takes, a schema link and the version.",
    "file": {
      "$schema": "./board.schema.json",
      "schemaVersion": 1,
      "title": "Order operations",
      "engines": ["shop-dev", "shop-test"],
      "rows": [
        {
          "row": [
            {
              "widget": "counter",
              "props": {
                "title": "Waiting for payment",
                "engines": ["shop-dev"],
                "filter": {
                  "process": "order",
                  "activeElement": "Task_Pay",
                  "state": "running",
                  "withIncident": false,
                  "businessKey": "B-1"
                },
                "warnAbove": 10
              }
            },
            {
              "widget": "instanceList",
              "props": {
                "title": "Ended orders",
                "engines": ["shop-test"],
                "filter": { "process": "order", "state": "ended" },
                "columns": [
                  "engine",
                  "process",
                  "version",
                  "businessKey",
                  "state",
                  "startedAt",
                  "endedAt",
                  "incident"
                ]
              }
            }
          ]
        },
        {
          "row": [
            {
              "widget": "incidentSummary",
              "props": {
                "title": "Per engine",
                "engines": ["shop-dev", "shop-test"],
                "groupBy": "engine"
              }
            },
            {
              "widget": "processDiagram",
              "props": { "title": "Order", "engines": ["shop-dev"], "process": "order" }
            },
            {
              "widget": "incidentList",
              "props": {
                "title": "Order incidents",
                "engines": ["shop-dev", "shop-test"],
                "process": "order"
              }
            }
          ]
        }
      ]
    },
    "schema": true,
    "verdict": {
      "board": {
        "title": "Order operations",
        "engines": ["shop-dev", "shop-test"],
        "rows": [
          [
            {
              "widget": "counter",
              "engines": ["shop-dev"],
              "title": "Waiting for payment",
              "filter": {
                "state": "running",
                "process": "order",
                "activeElement": "Task_Pay",
                "businessKey": "B-1",
                "withIncident": false
              },
              "warnAbove": 10
            },
            {
              "widget": "instanceList",
              "engines": ["shop-test"],
              "title": "Ended orders",
              "filter": { "state": "ended", "process": "order" },
              "columns": [
                "engine",
                "process",
                "version",
                "businessKey",
                "state",
                "startedAt",
                "endedAt",
                "incident"
              ]
            }
          ],
          [
            {
              "widget": "incidentSummary",
              "engines": ["shop-dev", "shop-test"],
              "title": "Per engine",
              "groupBy": "engine"
            },
            {
              "widget": "processDiagram",
              "engines": ["shop-dev"],
              "title": "Order",
              "process": "order"
            },
            {
              "widget": "incidentList",
              "engines": ["shop-dev", "shop-test"],
              "title": "Order incidents",
              "process": "order"
            }
          ]
        ]
      }
    }
  },
