{
  "name": "@miragon/pulse-http",
  "version": "0.27.1",
  "description": "One HTTP transport for the Pulse MCP server, the Pulse CLI and the C7 adapter of Pulse for VS Code and Pulse for Orca: a deadline to the last byte, no redirect, a size cap, one credential seam with one retry after 401, failure reasons as data, lossless JSON and masked secrets, over the fetch you hand it. No runtime dependency.",
  "license": "MIT",
  "keywords": [
    "http",
    "fetch",
    "transport",
    "rest",
    "camunda",
    "operaton",
    "cibseven"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/core/http#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/core/http"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/loopback": {
      "types": "./dist/testing/loopback/index.d.ts",
      "import": "./dist/testing/loopback/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.loopback.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.loopback.json && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
