{
  // The tests under test/ (the fakes, the property tests, the conformance run over the loopback
  // engine of src/testing/loopback), which see Node types like that engine's own project does.
  // src/ keeps its own project (tsconfig.json), where they stay compile errors.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["test"]
}
