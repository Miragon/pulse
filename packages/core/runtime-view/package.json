{
  "name": "@miragon/pulse-runtime-view",
  "private": true,
  "version": "0.27.1",
  "description": "The engine-neutral runtime view of Pulse's editor hosts (VS Code, Orca) over the engine contract of @miragon/pulse-engine-core: the ports a host and an engine family plug in, the core, the protocol, the webview, the local model reader and the host rules every editor host shares.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/core/runtime-view"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/webview/main.tsx"
  ],
  "exports": {
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./src/ports/index.ts"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./src/core/index.ts"
    },
    "./protocol": {
      "types": "./dist/core/protocol/index.d.ts",
      "import": "./src/core/protocol/index.ts"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./src/model/index.ts"
    },
    "./host-kit": {
      "types": "./dist/host-kit/index.d.ts",
      "import": "./src/host-kit/index.ts"
    },
    "./webview-build-options": "./scripts/webview-build-options.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ports.json && tsc -p tsconfig.core.json && tsc -p tsconfig.model.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.host-kit.json && tsc -p tsconfig.tooling.json && tsc -p tsconfig.build.json",
    "lint": "eslint src test dev scripts",
    "lint:fix": "eslint src test dev scripts --fix"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@miragon/modeler-shell": "0.12.0",
    "@miragon/pulse-engine-core": "workspace:*",
    "@miragon/pulse-profile": "workspace:*",
    "@miragon/pulse-ui": "workspace:*",
    "bpmn-js": "18.31.1",
    "bpmn-moddle": "10.3.1",
    "camunda-bpmn-moddle": "8.0.2",
    "diagram-js": "15.28.1",
    "preact": "11.2.0",
    "zeebe-bpmn-moddle": "2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
