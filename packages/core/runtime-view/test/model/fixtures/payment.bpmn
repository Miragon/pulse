<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Payment" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="payment" name="Payment" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Event_PaymentRequested" name="Payment requested">
      <bpmn:outgoing>Flow_PaymentRequestedToChargePayment</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_ChargePayment" name="Charge payment" camunda:type="external" camunda:topic="charge-payment">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="amount">${order.total}</camunda:inputParameter>
          <camunda:outputParameter name="paymentId">${receipt.id}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:errorEventDefinition id="Map_CardExpired" errorRef="Error_CardExpired" expression="${cardExpired}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentRequestedToChargePayment</bpmn:incoming>
      <bpmn:outgoing>Flow_ChargePaymentToNotifyCustomer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_CardExpired" name="Card expired" attachedToRef="Activity_ChargePayment">
      <bpmn:outgoing>Flow_CardExpiredToPaymentFailed</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_CardExpired" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_PaymentFailed" name="Payment failed">
      <bpmn:incoming>Flow_CardExpiredToPaymentFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CardExpiredToPaymentFailed" sourceRef="Event_CardExpired" targetRef="Event_PaymentFailed" />
    <bpmn:serviceTask id="Activity_NotifyCustomer" name="Notify customer" camunda:class="io.miragon.shop.notify.NotifyCustomerDelegate">
      <bpmn:incoming>Flow_ChargePaymentToNotifyCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyCustomerToWriteAuditLog</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_NotifyFailed" name="Any error" attachedToRef="Activity_NotifyCustomer">
      <bpmn:outgoing>Flow_NotifyFailedToNotificationFailed</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_NotificationFailed" name="Notification failed">
      <bpmn:incoming>Flow_NotifyFailedToNotificationFailed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_NotifyFailedToNotificationFailed" sourceRef="Event_NotifyFailed" targetRef="Event_NotificationFailed" />
    <bpmn:serviceTask id="Activity_WriteAuditLog" name="Write audit log" camunda:delegateExpression="${auditLogger}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="entry">
            <camunda:script scriptFormat="groovy">execution.id</camunda:script>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotifyCustomerToWriteAuditLog</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteAuditLogToRateRisk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_RateRisk" name="Rate risk" camunda:expression="${riskRating.rate(execution)}">
      <bpmn:incoming>Flow_WriteAuditLogToRateRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_RateRiskToPaymentDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_PaymentDone" name="Payment done">
      <bpmn:incoming>Flow_RateRiskToPaymentDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RateRiskToPaymentDone" sourceRef="Activity_RateRisk" targetRef="Event_PaymentDone" />
    <bpmn:sequenceFlow id="Flow_WriteAuditLogToRateRisk" sourceRef="Activity_WriteAuditLog" targetRef="Activity_RateRisk" />
    <bpmn:sequenceFlow id="Flow_NotifyCustomerToWriteAuditLog" sourceRef="Activity_NotifyCustomer" targetRef="Activity_WriteAuditLog" />
    <bpmn:sequenceFlow id="Flow_ChargePaymentToNotifyCustomer" sourceRef="Activity_ChargePayment" targetRef="Activity_NotifyCustomer" />
    <bpmn:sequenceFlow id="Flow_PaymentRequestedToChargePayment" sourceRef="Event_PaymentRequested" targetRef="Activity_ChargePayment" />
  </bpmn:process>
  <bpmn:error id="Error_CardExpired" name="CardExpired" errorCode="CARD_EXPIRED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_payment">
    <bpmndi:BPMNPlane id="BPMNPlane_payment" bpmnElement="payment">
      <bpmndi:BPMNShape id="BPMNShape_Event_PaymentRequested" bpmnElement="Event_PaymentRequested">
        <dc:Bounds x="80" y="121" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="61" y="163" width="75" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_ChargePayment" bpmnElement="Activity_ChargePayment">
        <dc:Bounds x="176" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_CardExpired" bpmnElement="Event_CardExpired">
        <dc:Bounds x="233" y="161" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="273" y="181" width="61" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_PaymentFailed" bpmnElement="Event_PaymentFailed">
        <dc:Bounds x="368" y="354" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="356" y="396" width="61" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_NotifyCustomer" bpmnElement="Activity_NotifyCustomer">
        <dc:Bounds x="336" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_NotifyFailed" bpmnElement="Event_NotifyFailed">
        <dc:Bounds x="393" y="161" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="433" y="181" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_NotificationFailed" bpmnElement="Event_NotificationFailed">
        <dc:Bounds x="528" y="258" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="498" y="300" width="96" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_WriteAuditLog" bpmnElement="Activity_WriteAuditLog">
        <dc:Bounds x="496" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_RateRisk" bpmnElement="Activity_RateRisk">
        <dc:Bounds x="656" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_PaymentDone" bpmnElement="Event_PaymentDone">
        <dc:Bounds x="816" y="121" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="804" y="163" width="61" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_CardExpiredToPaymentFailed" bpmnElement="Flow_CardExpiredToPaymentFailed">
        <di:waypoint x="251" y="197" />
        <di:waypoint x="251" y="372" />
        <di:waypoint x="368" y="372" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_NotifyFailedToNotificationFailed" bpmnElement="Flow_NotifyFailedToNotificationFailed">
        <di:waypoint x="411" y="197" />
        <di:waypoint x="411" y="276" />
        <di:waypoint x="528" y="276" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_RateRiskToPaymentDone" bpmnElement="Flow_RateRiskToPaymentDone">
        <di:waypoint x="756" y="139" />
        <di:waypoint x="816" y="139" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_WriteAuditLogToRateRisk" bpmnElement="Flow_WriteAuditLogToRateRisk">
        <di:waypoint x="596" y="139" />
        <di:waypoint x="656" y="139" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_NotifyCustomerToWriteAuditLog" bpmnElement="Flow_NotifyCustomerToWriteAuditLog">
        <di:waypoint x="436" y="139" />
        <di:waypoint x="496" y="139" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ChargePaymentToNotifyCustomer" bpmnElement="Flow_ChargePaymentToNotifyCustomer">
        <di:waypoint x="276" y="139" />
        <di:waypoint x="336" y="139" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_PaymentRequestedToChargePayment" bpmnElement="Flow_PaymentRequestedToChargePayment">
        <di:waypoint x="116" y="139" />
        <di:waypoint x="176" y="139" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
