<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_OrderFulfillment" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="order-fulfillment" name="Order fulfillment" isExecutable="true">
    <bpmn:startEvent id="Event_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_ReserveStock" name="Reserve stock">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Activity_CheckCredit" name="Check credit" calledElement="credit-scoring">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_CreditOk" name="Credit ok?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_ApproveOrder" name="Approve order">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_WaitForPickup" name="Wait for pickup">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDefinition_Pickup" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_PaymentReceived" name="Payment received">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDefinition_Payment" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_OrderShipped" name="Order shipped">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_OrderRejected" name="Order rejected">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_OrderReceived" targetRef="Activity_ReserveStock" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_ReserveStock" targetRef="Activity_CheckCredit" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_CheckCredit" targetRef="Gateway_CreditOk" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gateway_CreditOk" targetRef="Activity_ApproveOrder" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="no" sourceRef="Gateway_CreditOk" targetRef="Event_OrderRejected" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_ApproveOrder" targetRef="Event_WaitForPickup" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_WaitForPickup" targetRef="Event_PaymentReceived" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Event_PaymentReceived" targetRef="Activity_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_ShipOrder" targetRef="Event_OrderShipped" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderFulfillment">
    <bpmndi:BPMNPlane id="BPMNPlane_OrderFulfillment" bpmnElement="order-fulfillment">
      <bpmndi:BPMNShape id="Shape_Event_OrderReceived" bpmnElement="Event_OrderReceived">
        <dc:Bounds x="152" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_ReserveStock" bpmnElement="Activity_ReserveStock">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_CheckCredit" bpmnElement="Activity_CheckCredit">
        <dc:Bounds x="400" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_CreditOk" bpmnElement="Gateway_CreditOk" isMarkerVisible="true">
        <dc:Bounds x="555" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="547" y="151" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_ApproveOrder" bpmnElement="Activity_ApproveOrder">
        <dc:Bounds x="660" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_WaitForPickup" bpmnElement="Event_WaitForPickup">
        <dc:Bounds x="812" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="790" y="225" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_PaymentReceived" bpmnElement="Event_PaymentReceived">
        <dc:Bounds x="902" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="874" y="225" width="92" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Activity_ShipOrder" bpmnElement="Activity_ShipOrder">
        <dc:Bounds x="990" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_OrderShipped" bpmnElement="Event_OrderShipped">
        <dc:Bounds x="1142" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Event_OrderRejected" bpmnElement="Event_OrderRejected">
        <dc:Bounds x="562" y="302" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="400" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="500" y="200" />
        <di:waypoint x="555" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="605" y="200" />
        <di:waypoint x="660" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="620" y="182" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Rejected" bpmnElement="Flow_Rejected">
        <di:waypoint x="580" y="225" />
        <di:waypoint x="580" y="302" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="588" y="256" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="760" y="200" />
        <di:waypoint x="812" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="848" y="200" />
        <di:waypoint x="902" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="938" y="200" />
        <di:waypoint x="990" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1090" y="200" />
        <di:waypoint x="1142" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
