{
  "name": "@miragon/pulse-blocks",
  "version": "0.28.0",
  "description": "Pulse's building blocks for the surfaces that show the same engine view: the tiles of a board (counter, instance list, incident summary, incident list, process diagram and the tile of a refused widget) over a built board's JSON form of @miragon/pulse-board, worded in English and German, React on @miragon/pulse-ui with props and callbacks only. The surface brings its table, its id and its diagram as slots.",
  "license": "MIT",
  "keywords": [
    "react",
    "board",
    "dashboard",
    "bpmn",
    "process engine",
    "miragon"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/core/blocks#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/core/blocks"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-support.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@miragon/pulse-board": "workspace:*"
  },
  "peerDependencies": {
    "@miragon/pulse-ui": "workspace:^",
    "lucide-react": "^0.562.0 || ^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@miragon/pulse-ui": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
