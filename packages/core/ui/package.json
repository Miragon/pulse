{
  "name": "@miragon/pulse-ui",
  "version": "0.33.0",
  "description": "Pulse's design kit for MCP App views and your own React UIs: shadcn-based primitives, components, the tone model and type scale, locale, toasts and formatters, the BPMN diagram with Pulse's markers and badges (./bpmn), and the Miragon theme over the vendored corporate-design tokens.",
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "design-system",
    "tailwindcss",
    "mcp-apps",
    "miragon"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/core/ui#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/core/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-support.*",
    "!dist/render-*",
    "THIRD_PARTY_LICENSES.txt",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json",
    "!src/render-*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./tones": {
      "types": "./dist/tones/index.d.ts",
      "import": "./dist/tones/index.js"
    },
    "./bpmn": {
      "types": "./dist/bpmn/index.d.ts",
      "import": "./dist/bpmn/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./glossary": {
      "types": "./dist/glossary/index.d.ts",
      "import": "./dist/glossary/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./globals.css": "./src/globals.css",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "build": "tsc && node scripts/browser-bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "golden:update": "GOLDEN_UPDATE=1 vitest run src/glossary/glossary-page.test.ts --coverage.enabled=false",
    "third-party-licenses": "THIRD_PARTY_LICENSES_UPDATE=1 vitest run test/third-party-licenses.test.ts --coverage.enabled=false"
  },
  "peerDependencies": {
    "bpmn-js": "^18.31.1",
    "lucide-react": "^0.562.0 || ^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "bpmn-js": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.6.7",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bpmn-js": "18.31.1",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "lucide-react": "1.73.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
