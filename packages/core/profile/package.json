{
  "name": "@miragon/pulse-profile",
  "version": "0.28.0",
  "description": "One profile format for the Pulse CLI, Pulse for VS Code and the Pulse MCP server: a parser that takes the text of a profile file and returns a verdict per profile as data, the JSON Schema for editors and the shared fixtures. No runtime dependency.",
  "license": "MIT",
  "keywords": [
    "camunda",
    "camunda7",
    "operaton",
    "cibseven",
    "profile",
    "config",
    "json-schema"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/core/profile#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/core/profile"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "schema",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/pulse.schema.json": "./schema/pulse.schema.json",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
