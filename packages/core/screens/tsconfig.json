{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    // No DOM and no Node types: the screens run in the MCP server, in the editor hosts' Node and in
    // a browser, wherever a surface builds or reads a screen, so `document` and `process` stay
    // compile errors. The builder reads through the engine contract it is handed, nothing else.
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [],
    "composite": false,
    "outDir": "dist",
    "rootDir": "src",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
