{
  "name": "@miragon/pulse-screens",
  "version": "0.32.0",
  "description": "The screens of Pulse as data: the JSON forms of the screens the web app and the editors share and their codes, the targets a screen opens and the pure rules a surface applies to them (a process list's filter, the sums across engines), and in ./builder the numbers of each screen over the reads of the engine contract, a model of no text, with the one serializer into that form. The format has no runtime dependency; ./builder needs @miragon/pulse-engine-core and @miragon/pulse-board, optional peers.",
  "license": "MIT",
  "keywords": [
    "bpmn",
    "process engine",
    "operations",
    "dashboard",
    "json",
    "workflow"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/core/screens#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/core/screens"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "peerDependencies": {
    "@miragon/pulse-board": "workspace:^",
    "@miragon/pulse-engine-core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@miragon/pulse-board": {
      "optional": true
    },
    "@miragon/pulse-engine-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miragon/pulse-board": "workspace:*",
    "@miragon/pulse-engine-core": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
