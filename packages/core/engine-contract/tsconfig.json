{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    // No DOM and no Node types, as in Pulse for VS Code's contract layer
    // (apps/vscode/tsconfig.contract.json): an adapter runs the contract in the extension host,
    // in a browser or anywhere else JavaScript runs, so `document` and `process` stay compile
    // errors (test/runtime.boundary.ts proves it).
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [],
    "composite": false,
    "outDir": "dist",
    "rootDir": "src",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
