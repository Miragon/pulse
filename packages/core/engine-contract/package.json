{
  "name": "@miragon/pulse-engine-contract",
  "version": "0.27.1",
  "description": "The engine contract of Pulse, the shared language of its engine dialects: the read and write ports a process engine answers (ProcessRuntime, ProcessCommands), their ids, read models, queries and errors, and in ./testing the conformance kit with its laws, its fixed world and an in-memory fake engine. No runtime dependency.",
  "license": "MIT",
  "keywords": [
    "bpmn",
    "process engine",
    "contract",
    "ports",
    "conformance",
    "workflow"
  ],
  "homepage": "https://github.com/Miragon/pulse/tree/main/packages/core/engine-contract#readme",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "packages/core/engine-contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.test-support.*",
    "!src/**/test-support",
    "!src/**/tsconfig.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
