{
  "name": "@acme/mcp-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Example custom module for the composed-server template: team-notes tools and widget.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets": "./src/widgets/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.widgets.json"
  },
  "peerDependencies": {
    "@miragon/pulse-ui": "^0.27.1",
    "@miragon/pulse-widget-shell": "^0.27.1",
    "mcp-use": "2.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miragon/pulse-ui": "0.27.1",
    "@miragon/pulse-widget-shell": "0.27.1",
    "@tanstack/react-query": "5.105.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "happy-dom": "21.0.4",
    "lucide-react": "1.67.0",
    "mcp-use": "2.12.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
