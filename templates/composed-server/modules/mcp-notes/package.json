{
  "name": "@acme/mcp-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Example custom module for the composed-server template: team-notes tools and widget.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets": "./src/widgets/index.ts",
    "./definition": "./src/definition.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.widgets.json"
  },
  "dependencies": {
    "@miragon/pulse-widget-shell": "0.22.0"
  },
  "peerDependencies": {
    "@miragon/mcp-toolkit-core": "~2.8.1",
    "mcp-use": "2.7.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@miragon/mcp-toolkit-core": "2.8.1",
    "@miragon/mcp-toolkit-ui": "2.8.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.17",
    "mcp-use": "2.7.3",
    "react": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  }
}
