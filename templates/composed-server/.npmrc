# Exact pins across the board: the @miragon/pulse-* packages release in lockstep
# (upgrade them together to one version) and @miragon/mcp-toolkit-core peers
# mcp-use exactly: a floating range that drifts to a second toolkit instance
# resurrects the duplicate-React-context bug (widgets hang on "Loading…").
save-exact=true
shell-emulator=true
# Fail at install time on an unsupported Node version (mcp-use needs >=22.22.2,
# see `engines`) — the runtime failure would surface deep inside vite/mcp-use.
engine-strict=true
