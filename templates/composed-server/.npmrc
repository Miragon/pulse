# Exact pins in dependencies and devDependencies: the @miragon/pulse-* packages
# release in lockstep (upgrade them together to one version). A module's shared
# libraries are ranged peers on purpose, so they resolve to the server's one copy.
save-exact=true
shell-emulator=true
# Fail at install time on an unsupported Node version (see `engines`, the range
# the MCP inspector `pnpm dev` starts asks for: the patched release of each Node
# line) instead of a warning that scrolls by.
engine-strict=true
