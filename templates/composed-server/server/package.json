{
  "name": "@acme/composed-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Composed MCP server: Pulse modules (engine, analytics) plus the custom notes module.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build:ui": "vite build",
    "build:server": "tsc",
    "build": "pnpm run build:ui && pnpm run build:server",
    "dev": "pnpm run build:ui && mcp-use dev --port ${PORT:-8400} --no-open",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@acme/mcp-notes": "workspace:*",
    "@miragon/pulse-analytics-connector": "0.26.0",
    "@miragon/pulse-engine-connector": "0.26.0",
    "@miragon/pulse-widget-shell": "0.26.0",
    "mcp-use": "2.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@mcp-use/client": "2.4.5",
    "@miragon/pulse-ui": "0.26.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
