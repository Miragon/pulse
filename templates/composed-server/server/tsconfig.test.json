{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // view-registry.test.ts pulls the module views (tsx) into this program
    // via src/ui/view-registry.ts.
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "."
  },
  "include": ["src", "test"],
  "exclude": ["src/ui"]
}
