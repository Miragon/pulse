# Local configuration: copy to `.env` and adjust.
#
# Loaded by `pnpm dev` via dotenv-cli (plain KEY=VALUE lines, no `export`, no
# quotes around inline-JSON values); `pnpm start` and Docker take their config
# from the environment instead. Every variable here is read by this server;
# adding one it does NOT read prints an "Unknown environment variable"
# warning at boot.

# ── Server ────────────────────────────────────────────────────────────────
# HTTP port (default 8400) and bind address: `pnpm start` and the image
# listen on every interface (0.0.0.0), `pnpm dev` on 127.0.0.1. HOST=127.0.0.1
# keeps a server behind a proxy in the same host or pod off the network.
# PORT=8400
# HOST=0.0.0.0
# Public base URL when running behind a proxy or MCP gateway (advertised
# URLs, the Host/Origin the server accepts, and the origin the views load the
# Geist font from: /fonts/… on this server, declared in each view's CSP).
# With OAuth it is an origin without a path. Unset is right for local
# development.
# MCP_URL=https://mcp.example.com
# DNS-rebinding protection: a request whose Host (or, on a POST, Origin) is
# not localhost-class, MCP_URL's or listed here gets 403. Set MCP_URL (or
# these comma lists) when the server is reached under any other name. `*`
# turns a check off (only behind an edge that validates Host itself).
# /health and /metrics stay reachable by IP for probes and scrapers.
# MCP_ALLOWED_HOSTS=mcp.internal.example.com
# MCP_ALLOWED_ORIGINS=https://app.example.com
# Request-body cap in bytes (default 4194304 = 4 MiB): larger bodies get 413
# before they are read; 4x the cap is held across in-flight requests at most
# (503 beyond). `pnpm dev` (mcp-use dev) serves uncapped.
# MCP_MAX_BODY_BYTES=4194304
# Bearer token /metrics requires (unset = open, like the health probes).
# MCP_METRICS_TOKEN=change-me

# ── OAuth (optional): mcp-use's own provider variables ────────────────────
# Validates bearer tokens on /mcp against your IdP (no valid token → 401) and
# serves the .well-known discovery metadata; needs MCP_URL. Tokens must carry
# <MCP_URL>/mcp in `aud` (https://mcp.example.com/mcp, RFC 8707) and a `sub`
# claim; the boot logs the audience it expects, and the IdP checklist is at
# https://miragon.github.io/pulse/mcp/operations#identity-provider-checklist.
# It is the ONLY caller identity (passthrough auth,
# per-caller caches; the server warns at boot without it). It also raises the
# no-suffix toolsets from read-only to engine operations. Auth terminated in
# a gateway IN FRONT of the server is invisible here: identity reaches the
# server only through this OAuth. Set the variables of ONE provider; an
# incomplete provider, two providers, a value mcp-use refuses, or an MCP_USE_*
# variable the server does not read that names OAuth or a provider (an
# ..._AUDIENCE, a misspelled prefix) fails the boot, naming the variables.
# Keycloak (HTTPS, or HTTP on localhost only) and its realm:
# MCP_USE_OAUTH_KEYCLOAK_SERVER_URL=https://kc.example.com
# MCP_USE_OAUTH_KEYCLOAK_REALM=platform
# Auth0: the tenant domain or its issuer URL.
# MCP_USE_OAUTH_AUTH0_DOMAIN=tenant.eu.auth0.com
# WorkOS AuthKit: its host.
# MCP_USE_OAUTH_WORKOS_SUBDOMAIN=acme.authkit.app
# Better Auth: the auth URL, which is the issuer.
# MCP_USE_OAUTH_BETTER_AUTH_URL=https://auth.example.com/api/auth
# Convex: the auth URL.
# MCP_USE_OAUTH_CONVEX_AUTH_URL=https://example.convex.site
# Any value makes mcp-use log why a token failed verification (signature,
# issuer, sub, exp) with its claims; an audience mismatch it does not log,
# the 401's WWW-Authenticate header names it.
# MCP_USE_OAUTH_DEBUG=1

# Comma-separated module selection; unset or "all" activates every module. A
# module the list does not name stays off and its tools are absent (the boot
# log's Toolsets line shows what runs); an unknown name fails the boot. So a
# module you add to the server goes into this list, and one you remove comes
# out of it, here and in your copied .env.
# The live value below matches the engine in compose.yaml, which runs no
# Prometheus, so analytics stays off. To turn it on, add analytics to the list
# and set PROMETHEUS_URL below.
# Each module runs ONE toolset per boot, named by a `module:toolset` suffix
# (engine: read-only | operations | admin). Analytics and notes declare no
# toolsets (a suffix on them is ignored with a warning): such a module
# registers every tool, and the boot warns about each write it leaves open
# without OAuth. A module with toolsets and WITHOUT a
# suffix runs read-only without OAuth and its standard toolset with it; an
# empty (`engine:`) or unknown suffix warns and falls back to read-only, and
# admin is only ever reached by naming it. The boot log prints the effective
# toolsets. engine:operations in the list widens the engine module to its
# day-to-day writes; the full surface is engine:admin. A server with write
# toolsets and no OAuth is open to anyone who reaches its port (it listens
# on all interfaces): keep it on a trusted network.
MCP_ACTIVE_MODULES=engine,notes
# mcp-use's request log: info (default, one line per request, no payloads),
# debug (adds tool inputs and outputs) or trace (full dumps, tokens included).
# MCP_USE_LOG_LEVEL=info

# ── Camunda 7 / CIB seven engine (engine module) ────────────────────────
# The live values below match the engine in compose.yaml
# (`docker compose up -d`: CIB seven on localhost:8410, login demo/demo).
# The Pulse playground (https://github.com/Miragon/pulse/tree/main/playground)
# serves its engine on the same URL and adds metrics and Prometheus: for it,
# also uncomment ENGINE_ID here and PROMETHEUS_URL below, and add analytics to
# MCP_ACTIVE_MODULES above.
ENGINE_BASE_URL=http://localhost:8410/engine-rest
# Engine id for the single-engine shorthand above (default "default"). It MUST
# match the ENGINE_ID the engine stamps onto its metrics: that value becomes
# the `engine_id` label every analytics query is scoped to. A mismatch is
# silent: all analytics for the engine return nothing, its health `unknown`.
# The value below is the Pulse playground's; compose.yaml's engine stamps no
# metrics.
# ENGINE_ID=prod-a
# Engine vendor for the shorthand: camunda7 (default) | cibseven | operaton.
# It picks the cockpit-link routes and the product name the views show; the
# engine in compose.yaml and the playground's are CIB seven.
ENGINE_FLAVOR=cibseven
# Browser-reachable cockpit base URL for "open in cockpit" links. Derived from
# ENGINE_BASE_URL per vendor when unset; set it explicitly whenever the
# engine URL above is not reachable from the user's browser (e.g. a container
# hostname).
# ENGINE_COCKPIT_URL=http://localhost:8410/webapp
# none | basic | bearer | passthrough. basic requires USERNAME + PASSWORD and
# bearer requires TOKEN; both are enforced at boot. passthrough forwards each
# MCP caller's own bearer token to the engine per request.
ENGINE_AUTH_TYPE=basic
ENGINE_USERNAME=demo
ENGINE_PASSWORD=demo
# ENGINE_TOKEN=...                       # only for ENGINE_AUTH_TYPE=bearer
# Per-request deadline for every engine call in milliseconds (default 30000):
# a hung engine then fails the tool call with a timeout error. Whole
# milliseconds only; anything else fails the boot.
# ENGINE_REQUEST_TIMEOUT_MS=30000

# Multi-engine, overriding ENGINE_BASE_URL + ENGINE_ID. Each `id` is
# subject to the same match with the engine's own ENGINE_ID as above. Optional
# per entry: `flavor` ("cibseven" | "operaton" | "camunda7", default
# "camunda7") selects the vendor's cockpit routes, and `auth` overrides the
# global ENGINE_AUTH_TYPE settings. A JSON object instead of the array groups
# engines by environment ({"<environment>": [engines…]}) for the grouped
# environment → engine pickers. ENGINES_FILE points at a file holding
# the same JSON and wins over both.
# ENGINES_JSON=[{"id":"prod-a","baseUrl":"http://localhost:8410/engine-rest","flavor":"cibseven"},{"id":"prod-b","baseUrl":"http://localhost:8411/engine-rest","flavor":"operaton"}]
# ENGINES_FILE=./engines.json
# Where a call without `engine` goes when several engines are configured; it must name one of them.
# ENGINE_DEFAULT=prod-a

# The one owner/repo incident-ticket drafts target (their prefilled GitHub URL);
# unset = no URL. Operator config only: no tool argument can redirect it.
# ENGINE_INCIDENT_ISSUE_REPO=acme/operations
# Thresholds from which engine_status and the cockpit overview report critical.
# ENGINE_HEALTH_CRITICAL_INCIDENTS=50
# ENGINE_HEALTH_CRITICAL_CLUSTER_SIZE=1
# Registers engine_create_deployment, only together with engine:admin.
# Deploying a BPMN/DMN is CODE EXECUTION inside the engine JVM (JUEL
# expressions, scripts). Strict: only "true" or "false" (empty = unset); any
# other value fails the boot. Leave it unset unless deployments through the assistant are wanted.
# ENGINE_ALLOW_DEPLOYMENTS=true

# ── Prometheus (analytics module) ─────────────────────────────────────────
# compose.yaml runs no Prometheus, so MCP_ACTIVE_MODULES above leaves analytics
# off. With analytics on: the value below is the Pulse playground's, which
# publishes Prometheus on host port 8460. Unset defaults to
# http://localhost:9090, which does NOT match that stack: every analytics
# query then fails, and the server warns at boot.
# PROMETHEUS_URL=http://localhost:8460
# Optional auth for a protected Prometheus: EITHER a bearer token OR basic auth
# (userinfo in PROMETHEUS_URL is moved into the basic header too). Ambiguous
# combinations fail the boot; credentials never appear in tool errors.
# PROMETHEUS_BEARER_TOKEN=...
# PROMETHEUS_USERNAME=grafana
# PROMETHEUS_PASSWORD=...
# Extra request headers as a JSON object, e.g. a multi-tenant id.
# PROMETHEUS_HEADERS={"X-Scope-OrgID":"tenant-a"}
# Per-query deadline in milliseconds (default 30000; whole milliseconds only).
# PROMETHEUS_TIMEOUT_MS=30000
# Analytics reads ONLY the configured engines (a Prometheus may be shared with
# other teams): with the engine module active, its engine ids. A standalone
# analytics boot (no engine module) names them here, comma-separated engine_id values;
# with neither, every analytics tool refuses.
# ANALYTICS_ENGINE_IDS=prod-a,prod-b

# ── Notes (the example custom module) ─────────────────────────────────────
# Heading shown in the notes widget (default "Team Notes").
# NOTES_TITLE=Team Notes
