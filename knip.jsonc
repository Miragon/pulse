{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Dead-code fitness function (`pnpm lint:deadcode`, part of `pnpm lint`):
  // every check but unused exports and types, in every workspace. Exports and
  // types are `pnpm lint:deadcode:exports` (`--include exports,types`), in every
  // workspace but docs (below). Together they report every issue type in every
  // workspace (docs: all but exports and types), so no workspace runs on its own.
  // knip never reports what an ENTRY file exports (includeEntryExports is off):
  // the published entries' own lists are locked by their index tests.
  // Every ignore below is a documented exception: the list is shrink-only,
  // same convention as the ESLint ratchet lists.

  // Standalone customer-facing workspace OUTSIDE the pnpm workspace; verified
  // by scripts/test-template.sh against packed tarballs, not this graph.
  "ignore": ["templates/**"],

  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "vitest.shared.ts"],
    },

    "apps/mcp-server": {
      // The vite plugin stays off: the bundle entry (src/ui/main.tsx) and
      // vite.config.ts are listed below by hand, which is all it would add
      // (with it on, knip reports exactly those two entries as redundant).
      "vite": false,
      "entry": [
        "src/ui/main.tsx",
        // Parsed statically as an entry so its plugin imports count as used.
        "vite.config.ts",
        "test/**/*.test.ts",
        "test-host/**/*.{ts,mjs}",
      ],
    },

    "apps/cli": {
      // vitest.integration.config.ts runs the engine suites (`test:engines`) and
      // tsdown.standalone.config.ts builds the bundle of the standalone executable and the
      // image; neither name is one the plugins find on their own.
      "vitest": {
        "config": ["vitest.config.ts", "vitest.integration.config.ts"],
      },
      "tsdown": {
        "config": ["tsdown.config.ts", "tsdown.standalone.config.ts"],
      },
    },

    "apps/vscode": {
      // esbuild bundles the first four (scripts/build.mjs, scripts/webview-build-options.mjs,
      // scripts/dev-server.mjs, dev/webview/serve.mjs), the webview's dev scripts run by
      // hand (apps/vscode/src/webview/README.md) and @vscode/test-cli loads the smoke test
      // (.vscode-test.mjs); knip reads none of them.
      "entry": [
        "src/host/extension.ts",
        "src/webview/main.tsx",
        "dev/host/dev-host.ts",
        "dev/webview/stub.ts",
        "dev/webview/*.mjs",
        "test/smoke/*.test.cjs",
      ],
      "vitest": {
        "config": ["vitest.config.ts", "vitest.engines.config.ts"],
      },
      // The shop sandbox: a Java and JS project the extension's code links point at, not
      // code of the extension.
      "ignore": ["sandbox/**"],
    },

    "packages/connectors/engine/engine-client": {
      // Generated CIB seven SDK (pnpm generate): its export surface mirrors
      // the OpenAPI spec, not our usage.
      "ignore": ["src/generated/**"],
    },

    "packages/connectors/engine/engine-core": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "packages/core/http": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "docs": {
      // `lint:deadcode:exports` skips this workspace: its code is the vendored kit,
      // whose exports (miragonLegal, MiragonGitHub, …) are the kit's API for every
      // Miragon docs site and are never edited here.
      // The Miragon docs kit (.vitepress/miragon/, vendored unchanged from
      // Miragon/corporate-identity, pinned by its check.mjs): slug.d.mts types
      // slug.mjs for TypeScript, so no import names the declaration itself.
      "ignore": [".vitepress/miragon/slug.d.mts"],
      "ignoreDependencies": [
        // mermaid's diagram runtimes, which vitepress-plugin-mermaid lists in
        // Vite's optimizeDeps.include: under pnpm's strict layout the dev
        // server resolves them only as direct dependencies of docs (without
        // them `pnpm docs:dev` fails to resolve each one). Never imported by
        // our code.
        "@braintree/sanitize-url",
        "cytoscape",
        "cytoscape-cose-bilkent",
        "dayjs",
        "debug",
      ],
    },
  },
}
