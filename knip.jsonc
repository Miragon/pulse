{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Dead-code fitness function (`pnpm lint:deadcode`, part of `pnpm lint`).
  // Every ignore below is a documented exception — the list is shrink-only,
  // same convention as the ESLint ratchet lists.

  // Standalone customer-facing workspace OUTSIDE the pnpm workspace; verified
  // by scripts/test-template.sh against packed tarballs, not this graph.
  "ignore": ["templates/**"],

  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "vitest.shared.ts"],
    },

    "apps/mcp-server-camunda7": {
      // The UI bundle entries are declared explicitly and the vite plugin
      // stays off (historical: the pre-2.x config needed an INPUT env var);
      // the explicit list is stable and cheap to keep.
      "vite": false,
      // No stryker.config.json: exempt by NO_MUTATION_APPS (scripts/check-package-scripts.mjs).
      "entry": [
        "src/ui/main.tsx",
        // Parsed statically as an entry so its plugin imports count as used.
        "vite.config.ts",
        "test/**/*.test.ts",
        "test-host/**/*.{ts,mjs}",
      ],
    },

    "apps/vscode": {
      // esbuild bundles the first four (scripts/build.mjs, scripts/webview-build-options.mjs,
      // scripts/dev-server.mjs, dev/webview/serve.mjs), the webview's dev scripts run by
      // hand (apps/vscode/src/webview/README.md) and @vscode/test-cli loads the smoke test
      // (.vscode-test.mjs); knip reads none of them.
      "entry": [
        "src/host/extension.ts",
        "src/webview/main.tsx",
        "dev/host/dev-host.ts",
        "dev/webview/stub.ts",
        "dev/webview/*.mjs",
        "test/smoke/*.test.cjs",
      ],
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts", "vitest.engines.config.ts"],
      },
      // The shop sandbox: a Java and JS project the extension's code links point at, not
      // code of the extension.
      "ignore": ["sandbox/**"],
    },

    "packages/connectors/camunda/camunda7-client": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
      // Generated CIB Seven SDK (pnpm generate) — its export surface mirrors
      // the OpenAPI spec, not our usage.
      "ignore": ["src/generated/**"],
    },

    "packages/connectors/analytics/analytics-client": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "packages/connectors/camunda/camunda7-connector": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "packages/connectors/analytics/analytics-connector": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "packages/core/widget-shell": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.stryker.config.ts"],
      },
    },

    "docs": {
      // The Miragon docs kit (.vitepress/miragon/, vendored unchanged from
      // Miragon/corporate-identity, pinned by its check.mjs): slug.d.mts types
      // slug.mjs for TypeScript, so no import names the declaration itself.
      "ignore": [".vitepress/miragon/slug.d.mts"],
      "ignoreDependencies": [
        // mermaid's diagram runtimes, which vitepress-plugin-mermaid lists in
        // Vite's optimizeDeps.include: under pnpm's strict layout the dev
        // server resolves them only as direct dependencies of docs (without
        // them `pnpm docs:dev` fails to resolve each one). Never imported by
        // our code.
        "@braintree/sanitize-url",
        "cytoscape",
        "cytoscape-cose-bilkent",
        "dayjs",
        "debug",
        // Provided by vitepress, which aliases `vue` to its own copy; the kit's
        // theme imports it directly.
        "vue",
      ],
    },
  },
}
