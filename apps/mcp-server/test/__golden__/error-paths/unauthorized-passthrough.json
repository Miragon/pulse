{
  "case": "unauthorized-passthrough",
  "config": {
    "ENGINE_AUTH_TYPE": "passthrough",
    "ENGINE_BASE_URL": "http://127.0.0.1:<port>/engine-rest",
    "MCP_ACTIVE_MODULES": "engine",
    "MCP_OAUTH_KEYCLOAK_REALM": "platform",
    "MCP_OAUTH_KEYCLOAK_SERVER_URL": "http://127.0.0.1:<port>",
    "MCP_URL": "http://localhost"
  },
  "probes": [
    {
      "arguments": {
        "processInstanceId": "pi-1"
      },
      "result": {
        "content": [
          {
            "textLines": [
              "[401] empty response body (engine default). The engine rejected the forwarded bearer token."
            ],
            "type": "text"
          }
        ],
        "isError": true
      },
      "sent": [
        "GET /engine-rest/history/process-instance/pi-1 [Bearer <token>]",
        "GET /engine-rest/process-instance/pi-1 [Bearer <token>]"
      ],
      "tool": "engine_inspect_process_instance"
    }
  ]
}
