      "ui/resourceUri": "ui://views/engine_open_cockpit.html"
    },
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Show the user the operations cockpit; they navigate it without further tool calls. `view` picks where it opens: board shows a board across the engines it names, landing (the default) the engines and boards to pick from. You get that view's facts as compact JSON.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "board": {
          "description": "board (required): its id, as engine_list_engines lists the boards.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "view": {
          "enum": [
            "board",
            "landing"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "engine_open_cockpit",
