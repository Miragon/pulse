    "description": "Internal JSON feed (no UI) for one board of the server's board files (ENGINE_BOARDS_DIR), by its id: each engine's state and each tile's numbers, read from the engines the board names, kept for 30 seconds per caller.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "board": {
          "description": "The board's id: its file's name without .board.json.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "board"
      ],
      "type": "object"
    },
    "name": "engine_board_data",
    "title": "Board data (internal)"
