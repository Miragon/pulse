{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // Browser bundle: no Node globals (overrides the base), but Vite's ambient
    // types — TS 6 needs the `*.css` module declaration for the side-effect
    // import in src/ui/main.tsx.
    "types": ["vite/client"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/ui"],
  "exclude": []
}
