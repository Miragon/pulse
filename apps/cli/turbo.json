{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/cli/*.md"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/connectors/c7/c7-core/spec/*.json",
        "$TURBO_ROOT$/packages/connectors/c7/c7-core/src/generated/routes.json",
        "$TURBO_ROOT$/docs/cli/**",
        "$TURBO_ROOT$/release-please-config.json",
