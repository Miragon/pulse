{
  "name": "@miragon/pulse-cli",
  "version": "0.27.1",
  "description": "AI-first command line interface for the Camunda 7 REST API. Works with Operaton, CIB seven and Camunda 7.",
  "keywords": [
    "camunda",
    "camunda7",
    "operaton",
    "cibseven",
    "bpmn",
    "cli",
    "rest",
    "ai-agents",
    "pulse"
  ],
  "license": "MIT",
  "author": "Miragon GmbH",
  "homepage": "https://miragon.github.io/pulse/cli/",
  "bugs": "https://github.com/Miragon/pulse/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "pulse": "dist/pulse-cli.js",
    "pulse-cli": "dist/pulse-cli.js"
  },
  "files": [
    "dist",
    "schema",
    "skills",
    "!skills/pulse-cli/evals",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:standalone": "tsdown -c tsdown.standalone.config.ts",
    "build:exe": "tsx scripts/build-exe.ts",
    "catalog": "tsx scripts/generate-catalog.ts",
    "catalog:check": "tsx scripts/generate-catalog.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test *.config.ts",
    "lint:fix": "eslint src scripts test *.config.ts --fix",
    "test": "vitest run",
    "test:engines": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@miragon/pulse-engine-core": "workspace:*",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "tsdown": "0.23.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
