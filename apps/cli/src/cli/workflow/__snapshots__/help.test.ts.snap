exports[`workflow command describe > describes the options of advance 1`] = `
{
  "arguments": [
    {
      "description": "Process instance id; or select it with --business-key / --process-definition-key",
      "name": "process-instance-id",
      "required": false,
    },
  ],
  "examples": [
    "pulse-cli advance $INSTANCE_ID --var approved=true",
    "pulse-cli advance --business-key B-1 --activity-id charge-card --var charged=true --wait",
    "pulse-cli advance $INSTANCE_ID --activity-id charge-card --fail 'Card declined'",
  ],
  "options": [
    {
      "description": "Select the process instance by business key (running or ended)",
      "flag": "--business-key <key>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Select by process definition key; with --latest the most recently started instance",
      "flag": "--process-definition-key <key>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Take the most recently started instance that matches the filters",
      "flag": "--latest",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "The activity to advance when the instance waits at several places",
      "flag": "--activity-id <id>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Variable of the completion (process scope): name=value (auto typed: true/false, integers, decimals, null, else string) or name:Type=value (String, Integer, Short, Long, Double, Boolean, Date, Json, Xml, Null; Date accepts the date-time forms, e.g. 2024-05-01 or 2024-05-01T10:00:00+02:00); repeatable",
      "flag": "--var <name=value>",
      "repeatable": true,
      "required": false,
      "type": "variables",
    },
    {
      "description": "Local variable of an external task completion: name=value (auto typed: true/false, integers, decimals, null, else string) or name:Type=value (String, Integer, Short, Long, Double, Boolean, Date, Json, Xml, Null; Date accepts the date-time forms, e.g. 2024-05-01 or 2024-05-01T10:00:00+02:00); repeatable",
      "flag": "--local-var <name=value>",
      "repeatable": true,
      "required": false,
      "type": "variables",
    },
    {
      "description": "Throw a BPMN error with this code instead of completing (user and external tasks)",
      "flag": "--bpmn-error <code>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Message of the BPMN error",
      "flag": "--error-message <text>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Report a failure of the external task with this message instead of completing it",
      "flag": "--fail <message>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Retries left after --fail (default 0: an incident)",
      "flag": "--retries <n>",
      "required": false,
      "type": "integer",
    },
    {
      "description": "Worker that locks and completes an external task (default pulse-cli)",
      "flag": "--worker-id <id>",
      "required": false,
      "type": "string",
    },
    {
      "description": "After the writes, wait until the instance is idle before printing it",
      "flag": "--wait",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Wait until idle, ended, incident, task, task:<taskDefinitionKey> or activity:<activityId>; repeatable, any one ends the wait (implies --wait)",
      "flag": "--until <condition>",
      "repeatable": true,
      "required": false,
      "type": "condition",
    },
    {
      "description": "Total wait budget like 500ms, 30s, 2m or 1h (default 60s; --timeout is per request)",
      "flag": "--wait-timeout <duration>",
      "required": false,
      "type": "duration",
    },
    {
      "description": "Keep waiting when an incident appears (default: fail fast with INCIDENT)",
      "flag": "--no-fail-on-incident",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Leave out the variables of the instance view (and their request)",
      "flag": "--no-variables",
      "required": false,
      "type": "boolean",
    },
  ],
}
`;

exports[`workflow command describe > describes the options of deploy 1`] = `
{
  "arguments": [
    {
      "description": "BPMN, DMN and form files and directories to deploy",
      "name": "paths",
      "required": true,
      "variadic": true,
    },
  ],
  "examples": [
    "pulse-cli deploy src/main/resources",
    "pulse-cli deploy order-process.bpmn approval.dmn --start --business-key B-1 --var amount=250 --wait",
  ],
  "options": [
    {
      "description": "Deployment name (default pulse-cli); unchanged files are skipped per name",
      "flag": "--name <deployment-name>",
      "required": false,
      "type": "string",
    },
