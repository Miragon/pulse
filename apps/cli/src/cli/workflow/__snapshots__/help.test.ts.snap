exports[`workflow command describe text > renders the description of deploy 1`] = `
"USAGE
  operate deploy <paths...> [options]

DESCRIPTION
  Deploy changed BPMN, DMN and form files, report the versions in effect, optionally start an
  instance
  Effect: write

  Deploys files and directories (scanned for *.bpmn, *.bpmn20.xml, *.dmn, *.dmn11.xml and *.form,
  skipping dot-directories and node_modules) with the same deployment name and source every time, so
  unchanged files are skipped and keep their version. Reports per resource whether it was deployed
  now and the definitions in effect. --start or --start-key starts an instance and prints it.

ARGUMENTS
  <paths...>  BPMN, DMN and form files and directories to deploy

OPTIONS
  --name <deployment-name>   Deployment name (default operate); unchanged files are skipped per name
  --base-dir <dir>           Name every resource by its path relative to this directory
  --tenant-id <id>           Tenant of the deployment (and of the started instance)
  --start                    Start an instance of the only process of the deployed files
  --start-key <key>          Start an instance of this process definition key (implies --start)
  --business-key <key>       Business key of the started instance
  --var <name=value>         Variable of the started instance: name=value (auto typed: true/false,
                             integers, decimals, null, else string) or name:Type=value (String,
                             Integer, Short, Long, Double, Boolean, Date, Json, Xml, Null; Date
                             accepts the date-time forms, e.g. 2024-05-01 or
                             2024-05-01T10:00:00+02:00); repeatable
  --wait                     After the writes, wait until the instance is idle before printing it
  --until <condition>        Wait until idle, ended, incident, task, task:<taskDefinitionKey> or
                             activity:<activityId>; repeatable, any one ends the wait (implies
                             --wait)
  --wait-timeout <duration>  Total wait budget like 500ms, 30s, 2m or 1h (default 60s; --timeout is
                             per request)
  --no-fail-on-incident      Keep waiting when an incident appears (default: fail fast with
                             INCIDENT)
  --no-variables             Leave out the variables of the instance view (and their request)

REQUESTS
  getDeployments                    operate deployment list
  createDeployment                  operate deployment create
  getDeploymentResources            operate deployment get-resources
  getProcessDefinitions             operate process-definition list
  getDecisionDefinitions            operate decision-definition list
  getDecisionRequirementsDefinitions
                                    operate decision-requirements-definition list
  startProcessInstanceByKey         operate process-definition start
  startProcessInstanceByKeyAndTenantId
                                    operate process-definition start-by-key-and-tenant-id
  getProcessInstance                operate process-instance get
  getHistoricProcessInstance        operate historic-process-instance get
  getHistoricVariableInstances      operate historic-variable-instance list
  getProcessInstances               operate process-instance list
  getActivityInstanceTree           operate process-instance get-activity-instance-tree
  getIncidents                      operate incident list
  getEventSubscriptions             operate event-subscription list
  getTasks                          operate task list
  getExternalTasks                  operate external-task list
  getJobs                           operate job list
  getJobDefinitions                 operate job-definition list
  getProcessInstanceVariables       operate process-instance get-variables
  getStacktrace                     operate job get-stacktrace
  getExternalTaskErrorDetails       operate external-task get-error-details
  getProcessInstancesCount          operate process-instance count
  getJobsCount                      operate job count
  getTasksCount                     operate task count
  getHistoricActivityInstancesCount
                                    operate historic-activity-instance count

EXAMPLES
  operate deploy src/main/resources
  operate deploy order-process.bpmn approval.dmn --start --business-key B-1 --var amount=250 \\
      --wait
"
`;

