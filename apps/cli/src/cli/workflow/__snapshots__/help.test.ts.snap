exports[`workflow command describe > describes the options of retry 1`] = `
{
  "arguments": [
    {
      "description": "Process instance id; or select it with --business-key / --process-definition-key",
      "name": "process-instance-id",
      "required": false,
    },
  ],
  "examples": [
    "pulse-cli retry $INSTANCE_ID --now",
    "pulse-cli retry --incident $INCIDENT_ID",
    "pulse-cli retry --process-definition-key payment --activity-id call-psp --dry-run",
  ],
  "options": [
    {
      "description": "Select the process instance by business key (running or ended)",
      "flag": "--business-key <key>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Select by process definition key; with --latest the most recently started instance",
      "flag": "--process-definition-key <key>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Take the most recently started instance that matches the filters",
      "flag": "--latest",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Retry these incidents; comma separated, repeatable",
      "flag": "--incident <ids>",
      "repeatable": true,
      "required": false,
      "type": "string",
    },
    {
      "description": "Only incidents at this activity",
      "flag": "--activity-id <id>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Only incidents of this type",
      "enum": [
        "failedJob",
        "failedExternalTask",
      ],
      "flag": "--incident-type <type>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Retries to set (default 1)",
      "flag": "--retries <n>",
      "required": false,
      "type": "integer",
    },
    {
      "description": "Execute the retried jobs at once and report the ones that failed again",
      "flag": "--now",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "After the writes, wait until the instance is idle before printing it",
      "flag": "--wait",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Wait until idle, ended, incident, task, task:<taskDefinitionKey> or activity:<activityId>; repeatable, any one ends the wait (implies --wait)",
      "flag": "--until <condition>",
      "repeatable": true,
      "required": false,
      "type": "condition",
    },
    {
      "description": "Total wait budget like 500ms, 30s, 2m or 1h (default 60s; --timeout is per request)",
      "flag": "--wait-timeout <duration>",
      "required": false,
      "type": "duration",
    },
    {
      "description": "Keep waiting when an incident appears (default: fail fast with INCIDENT)",
      "flag": "--no-fail-on-incident",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Leave out the variables of the instance view (and their request)",
      "flag": "--no-variables",
      "required": false,
      "type": "boolean",
    },
  ],
}
`;

exports[`workflow command describe > describes the options of status 1`] = `
{
  "arguments": [],
  "examples": [
    "pulse-cli status",
    "pulse-cli status --process-definition-key payment --fail-on warning",
  ],
  "options": [
    {
      "description": "Only these process definition keys; repeatable",
      "flag": "--process-definition-key <key>",
      "repeatable": true,
      "required": false,
      "type": "string",
    },
    {
      "description": "Jobs and external tasks waiting longer than this are findings (default 5m)",
      "flag": "--stale-after <duration>",
      "required": false,
      "type": "duration",
    },
    {
      "description": "Incident groups to show, 1 to 100 (default 10)",
      "flag": "--max-groups <n>",
      "required": false,
      "type": "integer",
    },
    {
      "description": "Exit with code 9 (CHECK_FAILED) when the status reaches this level",
      "enum": [
        "warning",
        "critical",
      ],
      "flag": "--fail-on <level>",
      "required": false,
      "type": "string",
    },
  ],
}
`;

exports[`workflow command describe > describes the options of wait 1`] = `
{
  "arguments": [
    {
      "description": "Process instance id; or select it with --business-key / --process-definition-key",
      "name": "process-instance-id",
      "required": false,
    },
  ],
  "examples": [
    "pulse-cli wait $INSTANCE_ID",
    "pulse-cli wait --business-key B-1 --until task --until ended --wait-timeout 2m",
    "pulse-cli wait $INSTANCE_ID --until activity:book --execute-jobs",
    "pulse-cli wait --batch $BATCH_ID",
  ],
  "options": [
    {
      "description": "Select the process instance by business key (running or ended)",
      "flag": "--business-key <key>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Select by process definition key; with --latest the most recently started instance",
      "flag": "--process-definition-key <key>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Take the most recently started instance that matches the filters",
      "flag": "--latest",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Wait until idle, ended, incident, task, task:<taskDefinitionKey> or activity:<activityId>; repeatable, any one ends the wait",
      "flag": "--until <condition>",
      "repeatable": true,
      "required": false,
      "type": "condition",
    },
    {
      "description": "Total wait budget like 500ms, 30s, 2m or 1h (default 60s; --timeout is per request)",
      "flag": "--wait-timeout <duration>",
      "required": false,
      "type": "duration",
    },
    {
      "description": "Keep waiting when an incident appears (default: fail fast with INCIDENT)",
      "flag": "--no-fail-on-incident",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Execute due jobs of the instance tree on every poll instead of waiting for the job executor (a write)",
      "flag": "--execute-jobs",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Leave out the variables of the instance view (and their request)",
      "flag": "--no-variables",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Wait until this batch finished instead of a process instance",
      "flag": "--batch <batch-id>",
      "required": false,
      "type": "string",
    },
  ],
}
`;

exports[`workflow command describe text > renders the description of advance 1`] = `
"USAGE
  pulse-cli advance [process-instance-id] [options]

DESCRIPTION
  Complete what a process instance waits for: user task, external task, message, signal, timer or
  async job
  Effect: write; --dry-run sends the reads and previews the writes

  Completes what the process instance waits for, without passing ids around: completes a user task,
  locks and completes an external task (or reports a failure or BPMN error), triggers a message or
  signal at the waiting execution, signals a receive task, or executes a timer or an asynchronous
  job. Name the activity with --activity-id when the instance waits at several places.

ARGUMENTS
  [process-instance-id]  Process instance id; or select it with --business-key /
                         --process-definition-key

OPTIONS
  --business-key <key>            Select the process instance by business key (running or ended)
  --process-definition-key <key>  Select by process definition key; with --latest the most recently
                                  started instance
  --latest                        Take the most recently started instance that matches the filters
  --activity-id <id>              The activity to advance when the instance waits at several places
  --var <name=value>              Variable of the completion (process scope): name=value (auto
                                  typed: true/false, integers, decimals, null, else string) or
                                  name:Type=value (String, Integer, Short, Long, Double, Boolean,
                                  Date, Json, Xml, Null; Date accepts the date-time forms, e.g.
                                  2024-05-01 or 2024-05-01T10:00:00+02:00); repeatable
  --local-var <name=value>        Local variable of an external task completion: name=value (auto
                                  typed: true/false, integers, decimals, null, else string) or
                                  name:Type=value (String, Integer, Short, Long, Double, Boolean,
                                  Date, Json, Xml, Null; Date accepts the date-time forms, e.g.
                                  2024-05-01 or 2024-05-01T10:00:00+02:00); repeatable
  --bpmn-error <code>             Throw a BPMN error with this code instead of completing (user and
                                  external tasks)
  --error-message <text>          Message of the BPMN error
  --fail <message>                Report a failure of the external task with this message instead of
                                  completing it
  --retries <n>                   Retries left after --fail (default 0: an incident)
  --worker-id <id>                Worker that locks and completes an external task (default
                                  pulse-cli)
  --wait                          After the writes, wait until the instance is idle before printing
                                  it
  --until <condition>             Wait until idle, ended, incident, task, task:<taskDefinitionKey>
                                  or activity:<activityId>; repeatable, any one ends the wait
                                  (implies --wait)
  --wait-timeout <duration>       Total wait budget like 500ms, 30s, 2m or 1h (default 60s;
                                  --timeout is per request)
  --no-fail-on-incident           Keep waiting when an incident appears (default: fail fast with
                                  INCIDENT)
  --no-variables                  Leave out the variables of the instance view (and their request)

REQUESTS
  getHistoricProcessInstances       pulse-cli historic-process-instance list
  getProcessInstances               pulse-cli process-instance list
  getProcessInstance                pulse-cli process-instance get
  getHistoricProcessInstance        pulse-cli historic-process-instance get
  getHistoricVariableInstances      pulse-cli historic-variable-instance list
  getActivityInstanceTree           pulse-cli process-instance get-activity-instance-tree
  getIncidents                      pulse-cli incident list
  getEventSubscriptions             pulse-cli event-subscription list
  getTasks                          pulse-cli task list
  getExternalTasks                  pulse-cli external-task list
  getJobs                           pulse-cli job list
  getProcessDefinitions             pulse-cli process-definition list
  getJobDefinitions                 pulse-cli job-definition list
  getProcessInstanceVariables       pulse-cli process-instance get-variables
  getStacktrace                     pulse-cli job get-stacktrace
  getExternalTaskErrorDetails       pulse-cli external-task get-error-details
  complete                          pulse-cli task complete
  handleBpmnError                   pulse-cli task handle-bpmn-error
  lock                              pulse-cli external-task lock
  completeExternalTaskResource      pulse-cli external-task complete
  handleExternalTaskBpmnError       pulse-cli external-task handle-bpmn-error
  handleFailure                     pulse-cli external-task handle-failure
  unlock                            pulse-cli external-task unlock
  triggerEvent                      pulse-cli execution trigger-event
  throwSignal                       pulse-cli signal throw
  signalExecution                   pulse-cli execution signal
  executeJob                        pulse-cli job execute
  getJob                            pulse-cli job get
  getProcessDefinitionBpmn20Xml     pulse-cli process-definition xml-by-id
  getProcessDefinitionBpmn20XmlByKey
                                    pulse-cli process-definition xml
  getProcessInstancesCount          pulse-cli process-instance count
  getJobsCount                      pulse-cli job count
  getTasksCount                     pulse-cli task count
  getHistoricActivityInstancesCount
                                    pulse-cli historic-activity-instance count

EXAMPLES
  pulse-cli advance $INSTANCE_ID --var approved=true
  pulse-cli advance --business-key B-1 --activity-id charge-card --var charged=true --wait
  pulse-cli advance $INSTANCE_ID --activity-id charge-card --fail 'Card declined'
"
`;

