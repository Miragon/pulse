exports[`workflow command describe text > renders the description of retry 1`] = `
"USAGE
  operate retry [process-instance-id] [options]

DESCRIPTION
  Retry the failed jobs and external tasks of open incidents, optionally executing the jobs at once
  Effect: write; bulk with --process-definition-key alone (requires --yes); --dry-run sends the reads and previews the writes

  Sets the retries of the failed jobs and external tasks behind open incidents: the incidents of a
  process instance tree, the named incidents (--incident), or every incident of a process definition
  (--process-definition-key alone, a bulk operation that needs --yes). Propagated incidents are
  replaced by their root cause; other incident types are skipped with a hint. --now executes the
  jobs at once and reports a job that failed again as "failed" with its root cause.

ARGUMENTS
  [process-instance-id]  Process instance id; or select it with --business-key /
                         --process-definition-key

OPTIONS
  --business-key <key>            Select the process instance by business key (running or ended)
  --process-definition-key <key>  Select by process definition key; with --latest the most recently
                                  started instance
  --latest                        Take the most recently started instance that matches the filters
  --incident <ids>                Retry these incidents; comma separated, repeatable
  --activity-id <id>              Only incidents at this activity
  --incident-type <type>          Only incidents of this type. One of: failedJob,
                                  failedExternalTask.
  --retries <n>                   Retries to set (default 1)
  --now                           Execute the retried jobs at once and report the ones that failed
                                  again
  --wait                          After the writes, wait until the instance is idle before printing
                                  it
  --until <condition>             Wait until idle, ended, incident, task, task:<taskDefinitionKey>
                                  or activity:<activityId>; repeatable, any one ends the wait
                                  (implies --wait)
  --wait-timeout <duration>       Total wait budget like 500ms, 30s, 2m or 1h (default 60s;
                                  --timeout is per request)
  --no-fail-on-incident           Keep waiting when an incident appears (default: fail fast with
                                  INCIDENT)
  --no-variables                  Leave out the variables of the instance view (and their request)

REQUESTS
  getHistoricProcessInstances       operate historic-process-instance list
  getProcessInstances               operate process-instance list
  getProcessInstance                operate process-instance get
  getIncidents                      operate incident list
  getIncident                       operate incident get
  setJobRetries                     operate job set-retries
  setExternalTaskResourceRetries    operate external-task set-retries
  executeJob                        operate job execute
  getJob                            operate job get
  getStacktrace                     operate job get-stacktrace
  getProcessDefinitionBpmn20Xml     operate process-definition xml-by-id
  getProcessDefinitionBpmn20XmlByKey
                                    operate process-definition xml
  getProcessInstancesCount          operate process-instance count
  getJobsCount                      operate job count
  getTasksCount                     operate task count
  getHistoricActivityInstancesCount
                                    operate historic-activity-instance count
  getHistoricProcessInstance        operate historic-process-instance get
  getHistoricVariableInstances      operate historic-variable-instance list
  getActivityInstanceTree           operate process-instance get-activity-instance-tree
  getEventSubscriptions             operate event-subscription list
  getTasks                          operate task list
  getExternalTasks                  operate external-task list
  getJobs                           operate job list
  getProcessDefinitions             operate process-definition list
  getJobDefinitions                 operate job-definition list
  getProcessInstanceVariables       operate process-instance get-variables
  getExternalTaskErrorDetails       operate external-task get-error-details

EXAMPLES
  operate retry $INSTANCE_ID --now
  operate retry --incident $INCIDENT_ID
  operate retry --process-definition-key payment --activity-id call-psp --dry-run
"
`;

