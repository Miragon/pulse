exports[`workflow command describe text > renders the description of status 1`] = `
"USAGE
  pulse-cli status [options]

DESCRIPTION
  Triage the engine: grouped incidents with root cause, job executor and external task worker health
  Effect: read

  Engine triage in one call: the definitions with instances and incidents, the root incidents
  grouped by definition, activity, type and message with their root cause, overdue executable jobs
  (is the job executor running?), external task topics with waiting, locked and expired tasks (is a
  worker subscribed?), open tasks and failed batches. Every finding names the next command;
  --fail-on makes CI fail on findings.

OPTIONS
  --process-definition-key <key>  Only these process definition keys; repeatable
  --stale-after <duration>        Jobs and external tasks waiting longer than this are findings
                                  (default 5m)
  --max-groups <n>                Incident groups to show, 1 to 100 (default 10)
  --fail-on <level>               Exit with code 9 (CHECK_FAILED) when the status reaches this
                                  level. One of: warning, critical.

REQUESTS
  getRestAPIVersion               pulse-cli version get
  getProcessDefinitionStatistics  pulse-cli process-definition get-statistics
  getIncidents                    pulse-cli incident list
  getIncidentsCount               pulse-cli incident count
  getExternalTasks                pulse-cli external-task list
  getExternalTasksCount           pulse-cli external-task count
  getJobsCount                    pulse-cli job count
  getJobs                         pulse-cli job list
  getTasksCount                   pulse-cli task count
  getBatchStatistics              pulse-cli batch get-statistics
  getStacktrace                   pulse-cli job get-stacktrace
  getExternalTaskErrorDetails     pulse-cli external-task get-error-details

EXAMPLES
  pulse-cli status
  pulse-cli status --process-definition-key payment --fail-on warning
"
`;

