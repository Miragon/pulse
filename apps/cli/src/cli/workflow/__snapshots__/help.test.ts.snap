    },
    {
      "description": "Start an instance of this process definition key (implies --start)",
      "flag": "--start-key <key>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Business key of the started instance",
      "flag": "--business-key <key>",
      "required": false,
      "type": "string",
    },
    {
      "description": "Variable of the started instance: name=value (auto typed: true/false, integers, decimals, null, else string) or name:Type=value (String, Integer, Short, Long, Double, Boolean, Date, Json, Xml, Null; Date accepts the date-time forms, e.g. 2024-05-01 or 2024-05-01T10:00:00+02:00); repeatable",
      "flag": "--var <name=value>",
      "repeatable": true,
      "required": false,
      "type": "variables",
    },
    {
      "description": "After the writes, wait until the instance is idle before printing it",
      "flag": "--wait",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Wait until idle, ended, incident, task, task:<taskDefinitionKey> or activity:<activityId>; repeatable, any one ends the wait (implies --wait)",
      "flag": "--until <condition>",
      "repeatable": true,
      "required": false,
      "type": "condition",
    },
    {
      "description": "Total wait budget like 500ms, 30s, 2m or 1h (default 60s; --timeout is per request)",
      "flag": "--wait-timeout <duration>",
      "required": false,
      "type": "duration",
    },
    {
      "description": "Keep waiting when an incident appears (default: fail fast with INCIDENT)",
      "flag": "--no-fail-on-incident",
      "required": false,
      "type": "boolean",
    },
    {
      "description": "Leave out the variables of the instance view (and their request)",
      "flag": "--no-variables",
      "required": false,
      "type": "boolean",
    },
  ],
}
`;

