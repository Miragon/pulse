          "tokenEndpoint": "https://authentik.example.com/application/o/token/"
        }
      },
      "query": {
        "url": "https://c8.example.com/v2",
        "flavor": "camunda8",
        "auth": {
          "type": "clientCredentials",
          "tokenEndpoint": "https://tenant.b2clogin.com/tenant.onmicrosoft.com/oauth2/v2.0/token?p=B2C_1_app"
        }
      },
      "padded": {
        "url": "https://c8.example.com/v2",
        "flavor": "camunda8",
        "auth": {
          "type": "clientCredentials",
          "tokenEndpoint": "  https://login.example.com/oauth/token  "
        }
      }
    }
  },
  "cli": {
    "valid": true,
    "profiles": {
      "slash": {
        "refused": "names Camunda 8"
