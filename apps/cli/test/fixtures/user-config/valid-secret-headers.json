{
  "about": "Secret headers may live in the user's own file, not in a project file; Pulse for VS Code sends no profile headers.",
  "file": {
    "profiles": {
      "gateway": {
        "url": "http://localhost:8080/engine-rest",
        "headers": {
          "Authorization": "Bearer header-secret",
          "X-Api-Key": "key-secret"
        }
      }
    }
  },
  "cli": {
    "valid": true,
    "profiles": {
      "gateway": {
        "url": "http://localhost:8080/engine-rest",
        "flavor": "camunda7",
        "readOnly": false,
        "auth": "none"
      }
    }
  }
}
