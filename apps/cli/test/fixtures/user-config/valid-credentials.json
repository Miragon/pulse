{
  "about": "The user's own file may hold credentials, which a project file refuses; Pulse for VS Code reads none of them.",
  "file": {
    "profiles": {
      "basic-literal": {
        "url": "http://localhost:8080/engine-rest",
        "auth": {
          "type": "basic",
          "username": "demo",
          "password": "demo-secret"
        }
      },
      "basic-env": {
        "url": "http://localhost:8080/engine-rest",
        "auth": {
          "username": "demo",
          "passwordEnv": "DEV_PASSWORD"
        }
      },
      "oauth-literal": {
        "url": "http://localhost:8080/engine-rest",
        "auth": {
          "type": "oauth",
          "issuer": "https://login.example.com/realms/camunda",
          "clientId": "pulse-cli",
          "clientSecret": "client-secret"
        }
      },
      "oauth-env": {
        "url": "http://localhost:8080/engine-rest",
        "auth": {
          "type": "oauth",
          "issuer": "https://login.example.com/realms/camunda",
          "clientId": "pulse-cli",
          "clientSecretEnv": "OAUTH_SECRET"
        }
      }
    }
  },
  "cli": {
    "valid": true,
    "profiles": {
      "basic-literal": {
        "url": "http://localhost:8080/engine-rest",
        "flavor": "camunda7",
        "readOnly": false,
        "auth": "basic"
      },
      "basic-env": {
        "url": "http://localhost:8080/engine-rest",
        "flavor": "camunda7",
        "readOnly": false,
        "auth": "basic"
      },
      "oauth-literal": {
        "url": "http://localhost:8080/engine-rest",
        "flavor": "camunda7",
        "readOnly": false,
        "auth": "oauth"
      },
      "oauth-env": {
        "url": "http://localhost:8080/engine-rest",
        "flavor": "camunda7",
        "readOnly": false,
        "auth": "oauth"
      }
    }
  }
}
