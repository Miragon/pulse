<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_ReturnHandling" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="return-handling" name="Return handling" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Event_ReturnRequested" name="Return requested">
      <bpmn:outgoing>Flow_ReturnRequestedToCreateReturnLabel</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_CreateReturnLabel" name="Create return label" camunda:type="external" camunda:topic="create-return-label">
      <bpmn:incoming>Flow_ReturnRequestedToCreateReturnLabel</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateReturnLabelToAwaitParcel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_CreateReturnLabelToAwaitParcel" sourceRef="Activity_CreateReturnLabel" targetRef="Gateway_AwaitParcel" />
    <bpmn:eventBasedGateway id="Gateway_AwaitParcel">
      <bpmn:incoming>Flow_CreateReturnLabelToAwaitParcel</bpmn:incoming>
      <bpmn:outgoing>Flow_AwaitParcelToParcelReceived</bpmn:outgoing>
      <bpmn:outgoing>Flow_AwaitParcelToRecallAnnounced</bpmn:outgoing>
      <bpmn:outgoing>Flow_AwaitParcelToReturnWindowClosed</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_ParcelReceived" name="Parcel received">
      <bpmn:incoming>Flow_AwaitParcelToParcelReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_ParcelReceivedToInspectParcel</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ReturnParcelReceived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Activity_InspectParcel" name="Inspect parcel" camunda:candidateGroups="warehouse">
      <bpmn:incoming>Flow_ParcelReceivedToInspectParcel</bpmn:incoming>
      <bpmn:outgoing>Flow_InspectParcelToReturnClosed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_ReturnClosed" name="Return closed">
      <bpmn:incoming>Flow_InspectParcelToReturnClosed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_InspectParcelToReturnClosed" sourceRef="Activity_InspectParcel" targetRef="Event_ReturnClosed" />
    <bpmn:sequenceFlow id="Flow_ParcelReceivedToInspectParcel" sourceRef="Event_ParcelReceived" targetRef="Activity_InspectParcel" />
    <bpmn:sequenceFlow id="Flow_AwaitParcelToParcelReceived" sourceRef="Gateway_AwaitParcel" targetRef="Event_ParcelReceived" />
    <bpmn:intermediateCatchEvent id="Event_RecallAnnounced" name="Product recall announced">
      <bpmn:incoming>Flow_AwaitParcelToRecallAnnounced</bpmn:incoming>
      <bpmn:outgoing>Flow_RecallAnnouncedToHandledByRecall</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="Signal_ProductRecall" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_HandledByRecall" name="Handled by recall">
      <bpmn:incoming>Flow_RecallAnnouncedToHandledByRecall</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RecallAnnouncedToHandledByRecall" sourceRef="Event_RecallAnnounced" targetRef="Event_HandledByRecall" />
    <bpmn:sequenceFlow id="Flow_AwaitParcelToRecallAnnounced" sourceRef="Gateway_AwaitParcel" targetRef="Event_RecallAnnounced" />
    <bpmn:intermediateCatchEvent id="Event_ReturnWindowClosed" name="14 days">
      <bpmn:incoming>Flow_AwaitParcelToReturnWindowClosed</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnWindowClosedToReturnExpired</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_ReturnExpired" name="Return expired">
      <bpmn:incoming>Flow_ReturnWindowClosedToReturnExpired</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ReturnWindowClosedToReturnExpired" sourceRef="Event_ReturnWindowClosed" targetRef="Event_ReturnExpired" />
    <bpmn:sequenceFlow id="Flow_AwaitParcelToReturnWindowClosed" sourceRef="Gateway_AwaitParcel" targetRef="Event_ReturnWindowClosed" />
    <bpmn:sequenceFlow id="Flow_ReturnRequestedToCreateReturnLabel" sourceRef="Event_ReturnRequested" targetRef="Activity_CreateReturnLabel" />
  </bpmn:process>
  <bpmn:message id="Message_ReturnParcelReceived" name="ReturnParcelReceived" />
  <bpmn:signal id="Signal_ProductRecall" name="ProductRecall" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_return-handling">
    <bpmndi:BPMNPlane id="BPMNPlane_return-handling" bpmnElement="return-handling">
      <bpmndi:BPMNShape id="BPMNShape_Event_ReturnRequested" bpmnElement="Event_ReturnRequested">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="61" y="144" width="75" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_CreateReturnLabel" bpmnElement="Activity_CreateReturnLabel">
        <dc:Bounds x="176" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gateway_AwaitParcel" bpmnElement="Gateway_AwaitParcel">
        <dc:Bounds x="336" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_ParcelReceived" bpmnElement="Event_ParcelReceived">
        <dc:Bounds x="446" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="144" width="68" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_InspectParcel" bpmnElement="Activity_InspectParcel">
        <dc:Bounds x="542" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_ReturnClosed" bpmnElement="Event_ReturnClosed">
        <dc:Bounds x="702" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="693" y="144" width="54" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_RecallAnnounced" bpmnElement="Event_RecallAnnounced">
        <dc:Bounds x="446" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="427" y="262" width="75" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_HandledByRecall" bpmnElement="Event_HandledByRecall">
        <dc:Bounds x="574" y="220" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="551" y="262" width="82" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_ReturnWindowClosed" bpmnElement="Event_ReturnWindowClosed">
        <dc:Bounds x="446" y="316" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="434" y="358" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_ReturnExpired" bpmnElement="Event_ReturnExpired">
        <dc:Bounds x="574" y="316" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="562" y="358" width="61" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_CreateReturnLabelToAwaitParcel" bpmnElement="Flow_CreateReturnLabelToAwaitParcel">
        <di:waypoint x="276" y="120" />
        <di:waypoint x="336" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_InspectParcelToReturnClosed" bpmnElement="Flow_InspectParcelToReturnClosed">
        <di:waypoint x="642" y="120" />
        <di:waypoint x="702" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ParcelReceivedToInspectParcel" bpmnElement="Flow_ParcelReceivedToInspectParcel">
        <di:waypoint x="482" y="120" />
        <di:waypoint x="542" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_AwaitParcelToParcelReceived" bpmnElement="Flow_AwaitParcelToParcelReceived">
        <di:waypoint x="386" y="120" />
        <di:waypoint x="446" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_RecallAnnouncedToHandledByRecall" bpmnElement="Flow_RecallAnnouncedToHandledByRecall">
        <di:waypoint x="482" y="238" />
        <di:waypoint x="574" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_AwaitParcelToRecallAnnounced" bpmnElement="Flow_AwaitParcelToRecallAnnounced">
        <di:waypoint x="361" y="145" />
        <di:waypoint x="361" y="238" />
        <di:waypoint x="446" y="238" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ReturnWindowClosedToReturnExpired" bpmnElement="Flow_ReturnWindowClosedToReturnExpired">
        <di:waypoint x="482" y="334" />
        <di:waypoint x="574" y="334" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_AwaitParcelToReturnWindowClosed" bpmnElement="Flow_AwaitParcelToReturnWindowClosed">
        <di:waypoint x="361" y="145" />
        <di:waypoint x="361" y="334" />
        <di:waypoint x="446" y="334" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_ReturnRequestedToCreateReturnLabel" bpmnElement="Flow_ReturnRequestedToCreateReturnLabel">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="176" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
