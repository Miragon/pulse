{
  "images": {
    "camunda": "camunda/camunda:8.10.8",
    "keycloak": "quay.io/keycloak/keycloak:26.8.0",
    "elasticsearch": "docker.elastic.co/elasticsearch/elasticsearch:9.5.5"
  },
  "camunda": {
    "SPRING_PROFILES_ACTIVE": "broker,consolidated-auth,security"
  },
  "keycloak": {
    "KC_BOOTSTRAP_ADMIN_USERNAME": "admin",
    "KC_BOOTSTRAP_ADMIN_PASSWORD": "admin",
    "KC_HOSTNAME": "http://keycloak:8080"
  },
  "elasticsearch": {
    "discovery.type": "single-node",
    "xpack.security.enabled": "false",
    "cluster.routing.allocation.disk.threshold_enabled": "false",
    "ES_JAVA_OPTS": "-Xms1g -Xmx1g"
  },
  "storage": {
    "h2": {
      "CAMUNDA_DATA_SECONDARYSTORAGE_TYPE": "rdbms",
      "CAMUNDA_DATA_SECONDARYSTORAGE_RDBMS_URL": "jdbc:h2:mem:pulse;DB_CLOSE_DELAY=-1;MODE=PostgreSQL",
      "CAMUNDA_DATA_SECONDARYSTORAGE_RDBMS_USERNAME": "sa",
      "CAMUNDA_DATA_SECONDARYSTORAGE_RDBMS_PASSWORD": "",
      "CAMUNDA_DATA_SECONDARYSTORAGE_RDBMS_FLUSHINTERVAL": "PT0S"
    },
    "elasticsearch": {
      "CAMUNDA_DATA_SECONDARYSTORAGE_TYPE": "elasticsearch",
      "CAMUNDA_DATA_SECONDARYSTORAGE_ELASTICSEARCH_URL": "http://elasticsearch:9200"
    }
  },
  "security": {
    "none": {
      "CAMUNDA_SECURITY_AUTHENTICATION_UNPROTECTEDAPI": "true",
      "CAMUNDA_SECURITY_AUTHORIZATIONS_ENABLED": "false"
    },
    "basic": {
      "CAMUNDA_SECURITY_AUTHENTICATION_METHOD": "basic",
      "CAMUNDA_SECURITY_AUTHENTICATION_UNPROTECTEDAPI": "false",
      "CAMUNDA_SECURITY_AUTHORIZATIONS_ENABLED": "true",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_0_USERNAME": "seed",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_0_PASSWORD": "seed-password",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_0_NAME": "seed",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_0_EMAIL": "seed@example.com",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_1_USERNAME": "reader",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_1_PASSWORD": "reader-password",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_1_NAME": "reader",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_1_EMAIL": "reader@example.com",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_2_USERNAME": "nobody",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_2_PASSWORD": "nobody-password",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_2_NAME": "nobody",
      "CAMUNDA_SECURITY_INITIALIZATION_USERS_2_EMAIL": "nobody@example.com",
      "CAMUNDA_SECURITY_INITIALIZATION_DEFAULTROLES_ADMIN_USERS_0": "seed",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_OWNER_TYPE": "USER",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_OWNER_ID": "reader",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_RESOURCE_TYPE": "PROCESS_DEFINITION",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_RESOURCE_ID": "*",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_PERMISSIONS": "READ_PROCESS_DEFINITION,READ_PROCESS_INSTANCE,READ_USER_TASK"
    },
    "oidc": {
      "CAMUNDA_SECURITY_AUTHENTICATION_METHOD": "oidc",
      "CAMUNDA_SECURITY_AUTHENTICATION_UNPROTECTEDAPI": "false",
      "CAMUNDA_SECURITY_AUTHORIZATIONS_ENABLED": "true",
      "CAMUNDA_SECURITY_AUTHENTICATION_OIDC_ISSUERURI": "http://keycloak:8080/realms/pulse",
      "CAMUNDA_SECURITY_AUTHENTICATION_OIDC_CLIENTID": "camunda-app",
      "CAMUNDA_SECURITY_AUTHENTICATION_OIDC_CLIENTSECRET": "camunda-app-secret",
      "CAMUNDA_SECURITY_AUTHENTICATION_OIDC_REDIRECTURI": "http://localhost:8080/sso-callback",
      "CAMUNDA_SECURITY_AUTHENTICATION_OIDC_USERNAMECLAIM": "preferred_username",
      "CAMUNDA_SECURITY_AUTHENTICATION_OIDC_CLIENTIDCLAIM": "azp",
      "CAMUNDA_SECURITY_AUTHENTICATION_OIDC_AUDIENCES": "camunda",
      "CAMUNDA_SECURITY_INITIALIZATION_DEFAULTROLES_ADMIN_CLIENTS_0": "pulse-seed",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_OWNER_TYPE": "CLIENT",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_OWNER_ID": "pulse-reader",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_RESOURCE_TYPE": "PROCESS_DEFINITION",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_RESOURCE_ID": "*",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_0_PERMISSIONS": "READ_PROCESS_DEFINITION,READ_PROCESS_INSTANCE,READ_USER_TASK",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_1_OWNER_TYPE": "CLIENT",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_1_OWNER_ID": "pulse-short",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_1_RESOURCE_TYPE": "PROCESS_DEFINITION",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_1_RESOURCE_ID": "*",
      "CAMUNDA_SECURITY_INITIALIZATION_AUTHORIZATIONS_1_PERMISSIONS": "READ_PROCESS_DEFINITION,READ_PROCESS_INSTANCE,READ_USER_TASK"
    }
  }
}
