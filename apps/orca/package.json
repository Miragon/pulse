{
  "name": "@miragon/pulse-orca",
  "private": true,
  "version": "0.28.0",
  "description": "Pulse for Orca: the runtime view of Pulse for VS Code as an Orca plugin, for Operaton, CIB seven and Camunda 7.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "apps/orca"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "third-party-licenses": "THIRD_PARTY_LICENSES_UPDATE=1 vitest run test/third-party-licenses.test.ts --coverage.enabled=false",
    "test:kit": "vitest run --config vitest.kit.config.ts",
    "test:orca": "node scripts/orca-types.mjs && node scripts/orca.mjs plugin validate dist && node scripts/orca.mjs plugin check dist",
    "test:smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json && tsc -p tsconfig.frame.json",
    "lint": "eslint src test scripts",
    "lint:fix": "eslint src test scripts --fix"
  },
  "dependencies": {
    "@miragon/pulse-c7-adapter": "workspace:*",
    "@miragon/pulse-engine-core": "workspace:*",
    "@miragon/pulse-runtime-view": "workspace:*"
  },
  "devDependencies": {
    "@miragon/pulse-ui": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
