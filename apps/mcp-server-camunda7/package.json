{
  "name": "@miragon/pulse-mcp-server-camunda7",
  "version": "0.21.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/pulse.git",
    "directory": "apps/mcp-server-camunda7"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-camunda7": "dist/index.js"
  },
  "scripts": {
    "build:ui": "vite build",
    "build:server": "tsc",
    "build": "pnpm run build:ui && pnpm run build:server",
    "dev:ui": "vite build --watch",
    "dev": "pnpm run build:ui && mcp-use dev --port ${PORT:-8400} --no-open",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:host": "pnpm run build:ui && playwright test -c test-host",
    "lint": "eslint src test test-host",
    "lint:fix": "eslint src test test-host --fix",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "@miragon/pulse-analytics-connector": "workspace:*",
    "@miragon/pulse-camunda7-connector": "workspace:*",
    "@miragon/pulse-widget-shell": "workspace:*",
    "@miragon/mcp-toolkit-core": "2.8.1",
    "mcp-use": "2.7.3",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@miragon/mcp-toolkit-ui": "2.8.1",
    "@modelcontextprotocol/client": "2.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
