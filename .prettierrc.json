{
  "semi": false,
  "singleQuote": false,
  "printWidth": 100,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "**/.claude-plugin/*.json",
      "options": { "parser": "json-stringify" }
    },
    {
      "files": [
        "apps/vscode/**",
        "apps/orca/**",
        "packages/core/runtime-view/**",
        "packages/connectors/c7/c7-adapter/**"
      ],
      "options": {
        "plugins": []
      }
    },
    {
      "files": "packages/core/runtime-view/src/webview/**",
      "options": {
        "plugins": ["prettier-plugin-tailwindcss"],
        "tailwindPreserveWhitespace": true
      }
    }
  ]
}
