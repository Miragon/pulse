**/node_modules
**/dist
**/.turbo
**/*.tsbuildinfo
**/.DS_Store
# Local credentials, in every package, never in the image or the repo.
# `.env.example` is the committed template.
**/.env*
!**/.env.example
# Local profile records of the removed profile store, keyed by user id or
# e-mail: a checkout may still hold them, so never commit or ship them.
**/.profiles
**/.data
.git
.idea
.playwright-mcp
.ai
engine-plugins/.gradle
engine-plugins/build
engine-plugins/**/build
playground/cibseven-example/.gradle
playground/cibseven-example/build
# The CLI (apps/cli) builds its own image from its own context (apps/cli/Dockerfile); the
# server's build stage needs its package.json only, for the frozen workspace install.
apps/cli/*
!apps/cli/package.json

# The VS Code extension (apps/vscode): the VS Code test downloads (wherever vscode-test ran),
# packaged extensions, the dev-host build, its docs (screenshots) and the shop sandbox never
# enter the image build; the install needs its package.json only.
**/.vscode-test
apps/vscode/dist-dev
apps/vscode/docs
apps/vscode/sandbox
**/*.vsix
