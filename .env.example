# Local-dev configuration: copy to `.env` and adjust.
# Not needed for the playground: `pnpm play` sets the playground's values itself
# (a variable already set in your shell wins); `.env` is for `pnpm dev`.
#
# Loaded by `pnpm dev` via dotenv-cli (`dotenv -e .env`): plain KEY=VALUE
# lines, no `export`, no quotes around inline-JSON values. `pnpm dev` runs
# without a `.env` too: the boot then warns that no engine is configured and
# defaults to the playground engine's port.

# ── Camunda 7 / CIB seven engine (read by packages/connectors/engine/engine-connector/src/engine-profiles.ts) ──
# One engine: these variables describe it, and the server makes them its one
# profile. Several engines: a profile file in ENGINES_JSON or ENGINES_FILE
# below, which replaces them.
ENGINE_BASE_URL=http://localhost:8410/engine-rest
# Engine id for the single-engine shorthand above (default "default"): the
# `engine` value of every tool call, the name the cockpit shows and the id the
# hand-offs name. The server knows the Compose stack's engine as `prod-a`.
ENGINE_ID=prod-a
# Engine vendor for the shorthand: camunda7 (default) | cibseven | operaton.
# It picks the cockpit-link routes and the product name the views show; the
# Compose stack's engine is CIB seven.
ENGINE_FLAVOR=cibseven
# basic | bearer | passthrough | none: passthrough forwards each MCP caller's
# bearer token to the engine per request (no static credentials; requires an
# engine with REST authentication enabled, a default engine ignores the token).
# basic requires USERNAME+PASSWORD, bearer requires TOKEN, enforced at boot.
ENGINE_AUTH_TYPE=basic
ENGINE_USERNAME=demo
ENGINE_PASSWORD=demo
# ENGINE_TOKEN=...                      # only for ENGINE_AUTH_TYPE=bearer
# Per-request deadline for every engine call, in milliseconds (default 30000):
# a hung engine fails the tool call with "engine <id> did not respond within
# … ms" instead of holding it for minutes. Whole milliseconds only; anything
# else ("30s") fails the boot.
# ENGINE_REQUEST_TIMEOUT_MS=30000

# Several engines: one profile file, the format of the CLI and Pulse for VS
# Code (docs/mcp/reference.md), in ENGINES_JSON or, read from a path, in
# ENGINES_FILE (which wins). A profile's name is its engine id; `url` is the
# REST root; `flavor`, `environment` (groups the pickers and
# engine_list_engines), `cockpitUrl`, `timeout` and `readOnly` (no tool writes
# to it) are optional. Each profile signs in on its own: a secret stays out of
# the JSON, `auth.passwordEnv` / `auth.tokenEnv` name the variable that holds
# it, and only names that start with ENGINE_SECRET_ are read. A profile the
# server cannot use (a typo, an unset variable, headers) is refused on its own:
# the boot warns and a call to it says why. The second engine on :8411 only
# runs under `docker compose --profile multi-engine up -d`.
# ENGINES_JSON={"defaultProfile":"prod-a","profiles":{"prod-a":{"url":"http://localhost:8410/engine-rest","flavor":"cibseven","environment":"prod-eu","auth":{"type":"basic","username":"demo","passwordEnv":"ENGINE_SECRET_DEMO_PASSWORD"}},"prod-b":{"url":"http://localhost:8411/engine-rest","flavor":"cibseven","environment":"prod-us","readOnly":true,"auth":{"type":"basic","username":"demo","passwordEnv":"ENGINE_SECRET_DEMO_PASSWORD"}}}}
# ENGINE_SECRET_DEMO_PASSWORD=demo
#
# A Camunda 8 cluster is a profile too (`flavor` camunda8, `url` its REST root
# ending in /v2): the server reads it on boards only, and every other tool
# refuses it with ENGINE_DIALECT_NOT_SERVED. It signs in with none, basic or
# clientCredentials (`auth.clientSecretEnv` names the variable of the client
# secret; a credential never travels over plain http beyond this machine).
# The cluster `pnpm --filter @miragon/pulse-c8-adapter c8:up -- --security oidc`
# starts on this machine (Docker), next to the playground's engine:
# ENGINES_JSON={"profiles":{"prod-a":{"url":"http://localhost:8410/engine-rest","flavor":"cibseven","auth":{"type":"basic","username":"demo","passwordEnv":"ENGINE_SECRET_DEMO_PASSWORD"}},"c8-local":{"url":"http://localhost:18088/v2","cockpitUrl":"http://localhost:18088/operate","flavor":"camunda8","auth":{"type":"clientCredentials","tokenEndpoint":"http://localhost:18089/realms/pulse/protocol/openid-connect/token","clientId":"pulse-reader","audience":"camunda","clientSecretEnv":"ENGINE_SECRET_C8_CLIENT"}}}}
# ENGINE_SECRET_C8_CLIENT=reader-secret
#
# Where a call without `engine` routes when several engines are configured; it
# beats the file's defaultProfile (else the call fails with ENGINE_NOT_SELECTED
# listing the engines). It must name a profile, or the boot fails.
# ENGINE_DEFAULT=prod-a
#
# Boards: the directory of the board files (*.board.json, the format of Pulse
# for VS Code and Pulse for Orca, e.g. a repository's .pulse/boards). A board's
# engines are the profile names above. Read at boot, so a restart reloads them;
# a directory that cannot be read fails the boot, a file that gives no board
# warns. The app-only feed engine_board_data reads a board by its id.
# ENGINE_BOARDS_DIR=./.pulse/boards

# ── HTTP edge ──────────────────────────────────────────────────────────────
# HTTP port (default 8400) and bind address: `pnpm start` and the image
# listen on every interface (0.0.0.0), `pnpm dev` on 127.0.0.1. HOST=127.0.0.1
# keeps a server behind a proxy in the same host or pod off the network.
# PORT=8400
# HOST=0.0.0.0
# Public base URL when deployed behind a proxy, gateway or platform edge:
# advertised URLs, the origin of the OAuth token audience <MCP_URL>/mcp
# (required with OAuth, then an origin without a path), the Host/Origin the
# server accepts, and the origin the views load the Geist font from (/fonts/…
# on this server, declared in each view's CSP).
# `pnpm play --auth` sets http://localhost:<PORT>; `pnpm dev` sets nothing.
# MCP_URL=https://mcp.example.com
# DNS-rebinding protection: a request whose Host (or, on a POST, Origin) is
# not localhost-class, MCP_URL's or listed here gets 403. Set MCP_URL (or
# these comma lists) when the server is reached under any other name. `*`
# turns a check off (only behind an edge that validates Host itself).
# /health and /metrics stay reachable by IP for probes and scrapers.
# MCP_ALLOWED_HOSTS=mcp.internal.example.com
# MCP_ALLOWED_ORIGINS=https://app.example.com
# Request-body cap in bytes (default 4194304 = 4 MiB): larger bodies get 413
# before they are read; 4x the cap is held across in-flight requests at most
# (503 beyond). `pnpm dev` serves capped too (the same listener).
# MCP_MAX_BODY_BYTES=4194304
# Bearer token /metrics requires (unset = open, like the health probes).
# MCP_METRICS_TOKEN=change-me
# The request log on stdout: info (default, one line per request, no payloads;
# a failed request adds its error text), debug (adds tool arguments and
# results) or trace (full requests and responses, credential headers
# redacted). The boot warns at debug and trace.
# MCP_LOG_LEVEL=info

# ── Modules & toolsets ─────────────────────────────────────────────────────
# MCP_ACTIVE_MODULES picks the modules (unset or "all" = every module), each
# with an optional `:<toolset>` suffix. Without a suffix the default fails
# CLOSED: read-only on this unauthenticated server (no OAuth), the engine module's
# operations toolset under OAuth. `admin` is never implied; an empty
# (`engine:`) or unknown suffix warns and falls back to read-only. The boot log
# names the effective toolsets.
# The line below widens the dev server to the admin surface (deployments also
# need ENGINE_ALLOW_DEPLOYMENTS below).
# Without OAuth it is open to ANYONE who reaches port 8400: `pnpm dev`
# binds 127.0.0.1 (unless HOST/--host says otherwise), but `pnpm start` and a
# plain `docker run -p 8400:8400` listen on every network interface (the
# compose stack publishes on 127.0.0.1 only). Keep it to trusted networks.
# MCP_ACTIVE_MODULES=engine:admin
# Registers engine_create_deployment (only together with engine:admin).
# Deploying a BPMN/DMN is CODE EXECUTION inside the engine JVM: JUEL
# expressions and scripts run with the engine's privileges. Strict: only
# "true" or "false" (empty = unset); any other value fails the boot.
# ENGINE_ALLOW_DEPLOYMENTS=true

# ── OAuth (optional): one provider's variables ────────────────────────────
# Validates bearer tokens on /mcp against your IdP (requests without a valid
# token get 401) and serves the .well-known discovery metadata. Only the MCP
# endpoint is protected; widget assets and the dev inspector are not.
# Combine with passthrough auth (ENGINE_AUTH_TYPE=passthrough, or a profile's
# "auth": {"type": "passthrough"}) to forward the validated token to the
# engine. It is also the ONLY caller identity (passthrough auth,
# per-caller caches; the server warns at boot without it). OAuth also raises
# the no-suffix toolset default from read-only to engine operations (admin
# still has to be named). Auth terminated in a gateway or reverse proxy IN
# FRONT of the server is invisible to it: such a setup boots read-only unless
# MCP_ACTIVE_MODULES names the toolsets (identity only ever comes from this
# OAuth, never a header).
# Set the variables of ONE provider. Tokens must carry <MCP_URL>/mcp in aud
# (RFC 8707) and a sub claim (the generic provider: its own caller claim; Entra
# ID: below); the boot logs what the provider's tokens must carry. A variable
# under MCP_OAUTH_OIDC_ or MCP_OAUTH_ENTRA_ that the server does not read fails
# the boot, naming the one meant. What fails the boot:
# docs/mcp/operations.md#security. What to set up at the identity provider
# (Keycloak, Microsoft Entra ID, ADFS, Okta and others), how MCP clients
# register and what each provider's refusal at renewal catches:
# docs/mcp/identity-providers.md.
# Keycloak (HTTPS, or HTTP on localhost only) and its realm. Its tokens must
# also carry sid and auth_time, the session and the sign-in of a user (auth_time
# by the realm's basic scope, as Keycloak's built-in one maps it): a service
# account's token (client credentials) has no auth_time, and no sid unless its
# client keeps a session for it, and gets 401, as a password grant's does.
# Letting clients register themselves (anonymous Dynamic Client Registration)
# with the audience mapper in a realm default client scope gives every
# registrant such a token for Pulse, a session too through Keycloak's own
# registration endpoint, so keep Keycloak's default registration policies
# beside Trusted Hosts.
# MCP_OAUTH_KEYCLOAK_SERVER_URL=https://kc.example.com
# MCP_OAUTH_KEYCLOAK_REALM=platform
# Auth0: the tenant domain or its issuer URL.
# MCP_OAUTH_AUTH0_DOMAIN=tenant.eu.auth0.com
# WorkOS AuthKit: its host.
# MCP_OAUTH_WORKOS_SUBDOMAIN=acme.authkit.app
# Better Auth: the auth URL, which is the issuer.
# MCP_OAUTH_BETTER_AUTH_URL=https://auth.example.com/api/auth
# Convex: the auth URL.
# MCP_OAUTH_CONVEX_AUTH_URL=https://example.convex.site
# Any other OpenID Connect provider that issues JWT access tokens (ADFS 2019+,
# Okta, authentik, Zitadel, PingOne): its issuer exactly as its discovery names
# it (authentik's ends in a slash). The key set and the issuer its access tokens
# carry (ADFS's access_token_issuer) come from its discovery at the first token;
# until it answers, /mcp answers 503. Its tokens must carry <MCP_URL>/mcp in aud
# (ADFS: the Web API's identifier) and the caller claim. ADFS example:
# MCP_OAUTH_OIDC_ISSUER=https://fs.example.com/adfs
# Further audiences besides <MCP_URL>/mcp, comma-separated. One that is no https
# URL (a client id, a project id, Okta's api://default, which every app of the
# org shares) fails the boot without a scope in MCP_OAUTH_OIDC_SCOPES that only
# Pulse's clients are granted (openid, profile, email, address, phone and
# offline_access are in every sign-in's token): an ID token or another app's
# token can carry it. Never name an audience every sign-in's token carries (an
# IdP's userinfo URL).
# MCP_OAUTH_OIDC_AUDIENCE=https://pulse.example.com/mcp
# The scopes every token must carry, as the token carries them (default none).
# MCP_OAUTH_OIDC_SCOPES=user_impersonation
# The claim that names the caller (default sub; Okta: uid). ADFS access tokens
# carry none until the Web API's issuance transform rule emits one, e.g. sub
# from objectGUID. email, upn, unique_name, preferred_username and name fail
# the boot: their value can change or pass to another person.
# MCP_OAUTH_OIDC_SUBJECT_CLAIM=sub
# Narrows the signature algorithms (default: each asymmetric key's own); HS*
# and none fail the boot.
# MCP_OAUTH_OIDC_ALGORITHMS=RS256
# Only tokens of these clients pass (azp, appid, client_id or cid);
# MCP_WEB_CLIENT_ID joins the list. Unset, every client's. Name them beside the
# scope where the audience is shared (Okta's api://default, whose default access
# policy grants a custom scope to any client that asks).
# MCP_OAUTH_OIDC_CLIENT_IDS=claude-code,vscode
# Claims every token must carry besides the caller claim: Keycloak's sid and
# auth_time, of which a service account's token (client credentials) and a
# password grant's lack auth_time at least, where clients may register
# themselves and get one.
# MCP_OAUTH_OIDC_REQUIRED_CLAIMS=sid,auth_time
# Microsoft Entra ID, one tenant: its tenant id (a GUID; common, organizations,
# consumers, the personal accounts' tenant id and domain names fail the boot)
# and the API registration's client id. Tokens must be v2
# (requestedAccessTokenVersion 2 in the API's manifest; a v1 token is refused),
# of this tenant, with aud the API's client id or an App ID URI named below and
# the API's scope in scp; the caller is oid, else sub. The protected resource
# metadata names the tenant's oauth21/2026-08 authority; the web sign-in goes
# through its v2.0 one, without resource.
# MCP_OAUTH_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# MCP_OAUTH_ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# The scope the API exposes, short as scp carries it (default user_impersonation).
# MCP_OAUTH_ENTRA_SCOPE=user_impersonation
# The API's App ID URIs, comma-separated (default api://<client id>): the first
# starts the scope's full name, each passes as aud. MCP clients send
# <MCP_URL>/mcp as resource: register it as a further App ID URI of the API and
# name it here too, else a token with it as aud gets 401, since another app of
# the tenant could own that URI.
# MCP_OAUTH_ENTRA_APP_ID_URI=api://00000000-0000-0000-0000-000000000000,https://pulse.example.com/mcp
# The cloud (default https://login.microsoftonline.com; also
# https://login.microsoftonline.us and https://login.partner.microsoftonline.cn).
# MCP_OAUTH_ENTRA_AUTHORITY=https://login.microsoftonline.com
# Only tokens of these clients pass (azp); MCP_WEB_CLIENT_ID joins the list.
# Unset, every client's.
# MCP_OAUTH_ENTRA_CLIENT_IDS=aebc6443-996d-45c2-90f0-388ff96faa56
# 1 (or true) makes the server log why a token was refused (signature,
# issuer, audience, sub, exp) with the claims it checked, never the token; the
# 401's WWW-Authenticate header names the reason too.
# MCP_OAUTH_DEBUG=1
#
# Local playground: `docker compose --profile auth up -d` adds a Keycloak on
# host port 8480 (realm `miragon`, user demo/demo, seeded from
# playground/docker/keycloak/realm-miragon.json; admin console admin/admin).
# Point the server at it with the three lines below (`pnpm play --auth` sets
# them); MCP clients register with the IdP directly (Dynamic Client
# Registration: the seeded Trusted Hosts policy admits clients with loopback
# redirect URIs and rejects foreign hosts; it also trusts github.com, the
# client_uri the MCP Inspector names). The seeded realm stamps the
# required aud http://localhost:8400/mcp via the `mcp-resource` client scope
# (RFC 8707) and keeps the `sub` claim the provider requires via the seeded
# `basic` scope. Realm-file changes need `docker compose --profile auth up -d
# --force-recreate keycloak` to re-import.
# MCP_URL=http://localhost:8400
# MCP_OAUTH_KEYCLOAK_SERVER_URL=http://localhost:8480
# MCP_OAUTH_KEYCLOAK_REALM=miragon

# ── Web app sign-in (optional; needs an OAuth provider above) ─────────────
# MCP_WEB_CLIENT_ID turns on the web app's sign-in under <MCP_URL>/app: people
# sign in through the provider above as this confidential client (code flow
# with PKCE), and their session lives in a sealed __Host- cookie, never on the
# server. Register the client with the redirect URI <MCP_URL>/app/auth/callback
# and the post-logout URI <MCP_URL>/app/signed-out, and give its tokens the aud
# <MCP_URL>/mcp (Keycloak: an audience mapper): a token /mcp would refuse fails
# the sign-in. It needs MCP_URL (https, or http on localhost only), the client
# secret and session keys, or the boot fails; so does a provider-less boot with
# MCP_WEB_CLIENT_ID, and an MCP_WEB_* variable other than MCP_WEB_DIR without
# MCP_WEB_CLIENT_ID (the web app would stay off).
# The provider's side and every refusal: docs/web/sign-in.md. Local playground:
# `pnpm play --web` sets all of these against the playground's Keycloak (its
# client pulse-web, a new key per run, the build in apps/web/dist): sign in at
# http://localhost:8400/app as demo/demo.
# MCP_WEB_CLIENT_ID=pulse-web
# MCP_WEB_CLIENT_SECRET=change-me
# The scopes the sign-in asks for, separated by spaces or commas, in place of
# the provider's own (Keycloak openid profile; the generic provider openid,
# which suits ADFS: it has no profile or email scope and issues refresh tokens
# without offline_access); the scopes the provider requires are asked besides.
# Okta, authentik and Zitadel: openid profile offline_access.
# MCP_WEB_SCOPES=openid profile offline_access
# Comma-separated keys of at least 32 random bytes in base64url, e.g. from
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))".
# The first seals, every one opens. Rotate in two steps: add the new key last
# on every replica, then, once every replica runs it, put it first; drop the
# old one MCP_WEB_SESSION_HOURS later. One replica may put it first at once.
# MCP_WEB_SESSION_KEYS=<key>,<older key>
# How long a session lasts from its sign-in, in whole hours (default 8, at
# most 24), however often its tokens renew.
# MCP_WEB_SESSION_HOURS=8
# Checks each session at the provider at least this often, in whole minutes
# (1 to 60): its token is renewed then, whatever its lifetime, so a session the
# provider ended, a user it disabled or access it revoked ends within that
# time. Unset (the default), a token is renewed only shortly before it expires,
# so the provider's access-token lifetime decides. What a refusal catches
# differs per provider (Keycloak: an SSO logout; Entra ID: a disabled user,
# revoked sessions, Conditional Access, not a single sign-out; ADFS and Okta
# renew after a logout): docs/mcp/identity-providers.md.
# The web client needs refresh tokens. Turn their rotation off for it, as a
# confidential client may (Keycloak's Revoke Refresh Token, Auth0's Refresh
# Token Rotation, Okta's rotation): where they rotate, a renewal whose answer
# never reaches the browser (a closed tab, a lost connection) ends the session
# at the second refusal of the spent token, on one replica too.
# MCP_WEB_SESSION_CHECK_MINUTES=5
# The folder of the web build served under <MCP_URL>/app (index.html, the
# pages.json that names its page routes, assets/), read once at boot; it
# overrides the server package's web/ folder, which the image fills. Without a
# build there the boot fails while MCP_WEB_CLIENT_ID is set. The one MCP_WEB_*
# variable that may come without MCP_WEB_CLIENT_ID.
# MCP_WEB_DIR=./web

# ── Optional thresholds ────────────────────────────────────────────────────
# The live verdict's thresholds (defaults 50 / 25), for engine_status and the
# cockpit overview alike: "critical" at >= CRITICAL_INCIDENTS open incidents in
# total, or when one cause reaches >= CRITICAL_CLUSTER_SIZE incidents.
# ENGINE_HEALTH_CRITICAL_INCIDENTS=50
# ENGINE_HEALTH_CRITICAL_CLUSTER_SIZE=25
