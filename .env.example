# Local-dev configuration — copy to `.env` and adjust.
#
# Loaded by `pnpm dev` via dotenv-cli (`dotenv -e .env`): plain KEY=VALUE
# lines, no `export`, no quotes around inline-JSON values. `pnpm dev` runs
# without a `.env`, but analytics then default to the wrong Prometheus port
# (see PROMETHEUS_URL below).

# ── Camunda 7 / CIB Seven engine (read by packages/connectors/camunda/camunda7-connector/src/module.ts) ──
CAMUNDA_BASE_URL=http://localhost:8410/engine-rest
# Engine id for the single-engine shorthand above (default "default"). MUST
# match the engine container's ENGINE_ID — that value becomes the `engine_id`
# label on every metric, and analytics reads only the configured engine ids.
# A mismatch is silent: every analytics query for the engine returns nothing
# and its health reads `unknown`. The Compose stack's engine identifies as
# `prod-a`.
CAMUNDA_ENGINE_ID=prod-a
# Engine vendor for the shorthand: camunda7 (default) | cibseven | operaton.
# It picks the cockpit-link routes and the product name the views show; the
# Compose stack's engine is CIB seven.
CAMUNDA_ENGINE_FLAVOR=cibseven
# basic | bearer | passthrough | none — passthrough forwards each MCP caller's
# bearer token to the engine per request (no static credentials; requires an
# engine with REST authentication enabled, a default engine ignores the token).
# basic requires USERNAME+PASSWORD, bearer requires TOKEN — enforced at boot.
CAMUNDA_AUTH_TYPE=basic
CAMUNDA_USERNAME=demo
CAMUNDA_PASSWORD=demo
# CAMUNDA_TOKEN=...                      # only for CAMUNDA_AUTH_TYPE=bearer
# Per-request deadline for every engine call, in milliseconds (default 30000):
# a hung engine fails the tool call with "engine <id> did not respond within
# … ms" instead of holding it for minutes. Whole milliseconds only; anything
# else ("30s") fails the boot.
# CAMUNDA_REQUEST_TIMEOUT_MS=30000

# Multi-engine (overrides CAMUNDA_BASE_URL + CAMUNDA_ENGINE_ID). Each `id` is
# subject to the same ENGINE_ID match as above. The second engine on :8411 only
# runs under `docker compose --profile multi-engine up -d`. Each entry may
# carry its own `auth` ({type, username?, password?, token?}); entries without
# one fall back to the global CAMUNDA_* settings above.
# Optional per engine: "flavor" ("cibseven" | "operaton" | "camunda7", default "camunda7") selects
# the vendor's cockpit-link routes — mixed fleets in one server are supported.
# Both Compose engines are CIB seven.
# CAMUNDA_ENGINES_JSON=[{"id":"prod-a","baseUrl":"http://localhost:8410/engine-rest","flavor":"cibseven"},{"id":"prod-b","baseUrl":"http://localhost:8411/engine-rest","flavor":"cibseven","auth":{"type":"basic","username":"demo","password":"demo"}}]
#
# Environment-map form (same var, JSON object instead of array): keys are
# environment ids, values are that environment's engine entries — pickers and
# `camunda7_list_engines` then group the engines by environment.
# Engine ids stay globally unique (they remain the ENGINE_ID join key); the
# flat array form may equivalently carry "environment" per entry.
# CAMUNDA_ENGINES_JSON={"prod-eu":[{"id":"prod-a","baseUrl":"http://localhost:8410/engine-rest","flavor":"cibseven"}],"prod-us":[{"id":"prod-b","baseUrl":"http://localhost:8411/engine-rest","flavor":"cibseven"}]}

# ── HTTP edge ──────────────────────────────────────────────────────────────
# Public base URL when deployed behind a proxy, gateway or platform edge:
# advertised URLs, the OAuth token audience (required with MCP_OAUTH), the
# Host/Origin the server accepts, and the origin the views load the Geist font
# from (/fonts/… on this server, declared in each view's CSP).
# `pnpm dev` sets it for localhost itself.
# MCP_URL=https://mcp.example.com
# DNS-rebinding protection: a request whose Host (or, on a POST, Origin) is
# not localhost-class, MCP_URL's or listed here gets 403 — set MCP_URL (or
# these comma lists) when the server is reached under any other name. `*`
# turns a check off (only behind an edge that validates Host itself).
# /health and /metrics stay reachable by IP for probes and scrapers.
# MCP_ALLOWED_HOSTS=mcp.internal.example.com
# MCP_ALLOWED_ORIGINS=https://app.example.com
# Request-body cap in bytes (default 4194304 = 4 MiB): larger bodies get 413
# before they are read; 4x the cap is held across in-flight requests at most
# (503 beyond). `pnpm dev` (mcp-use dev) serves uncapped.
# MCP_MAX_BODY_BYTES=4194304
# Bearer token /metrics requires (unset = open, like the health probes).
# MCP_METRICS_TOKEN=change-me

# ── Modules & toolsets ─────────────────────────────────────────────────────
# MCP_ACTIVE_MODULES picks the modules (unset or "all" = every module), each
# with an optional `:<toolset>` suffix. Without a suffix the default fails
# CLOSED: read-only on this unauthenticated server (no MCP_OAUTH), the module's
# standard toolset under OAuth (camunda7 operations, analytics standard).
# `admin` is never implied; an empty (`camunda7:`) or unknown suffix warns and
# falls back to read-only. The boot log names the effective toolsets.
# The line below widens the dev server to the admin surface (deployments also
# need CAMUNDA_ALLOW_DEPLOYMENTS below, the dashboard builder needs MCP_OAUTH).
# Without MCP_OAUTH it is open to ANYONE who reaches port 8400: `pnpm dev`
# binds 127.0.0.1 (unless HOST/--host says otherwise), but `pnpm start` and a
# plain `docker run -p 8400:8400` listen on every network interface (the
# compose stack publishes on 127.0.0.1 only). Keep it to trusted networks.
# MCP_ACTIVE_MODULES=camunda7:admin,analytics:standard
# Registers camunda7_create_deployment (only together with camunda7:admin).
# Deploying a BPMN/DMN is CODE EXECUTION inside the engine JVM — JUEL
# expressions and scripts run with the engine's privileges. Strict: only
# "true" or "false" (empty = unset); any other value fails the boot.
# CAMUNDA_ALLOW_DEPLOYMENTS=true

# ── Prometheus (analytics data source) ────────────────────────────────────
# The Compose stack publishes Prometheus on host port 8460. Unset → defaults
# to http://localhost:9090 (the bare Prometheus port), which does NOT match
# the stack and makes every analytics query 404 (the server warns at boot).
PROMETHEUS_URL=http://localhost:8460
# Optional auth for a protected Prometheus (or Mimir/Cortex/Thanos/VictoriaMetrics
# behind an auth proxy): EITHER a bearer token OR basic auth — userinfo in
# PROMETHEUS_URL (https://user:pass@host) is moved into the basic header too.
# Ambiguous combinations fail the boot; credentials never appear in tool errors.
# PROMETHEUS_BEARER_TOKEN=...
# PROMETHEUS_USERNAME=grafana
# PROMETHEUS_PASSWORD=...
# Extra request headers as a JSON object, e.g. a multi-tenant id.
# PROMETHEUS_HEADERS={"X-Scope-OrgID":"tenant-a"}
# Per-query deadline in milliseconds (default 30000; whole milliseconds only).
# PROMETHEUS_TIMEOUT_MS=30000
# Analytics reads ONLY the configured engines (a Prometheus may be shared with
# other teams): with camunda7 active, its engine ids. A standalone analytics
# boot (camunda7 inactive) names them here, comma-separated engine_id values;
# with neither, every analytics tool refuses.
# ANALYTICS_ENGINE_IDS=prod-a,prod-b

# ── MCP_OAUTH — optional OAuth resource server ─────────────────────────────
# Validates bearer tokens on /mcp against your IdP (requests without a valid
# token get 401) and serves the .well-known discovery metadata. Only the MCP
# endpoint is protected — widget assets and the dev inspector are not.
# Combine with CAMUNDA_AUTH_TYPE=passthrough to forward the validated token
# to the engine. It is also the ONLY caller identity for persisted user
# settings, incl. the default engine: without MCP_OAUTH settings cannot be
# saved (defaults + per-call `engine`; the server warns at boot).
# OAuth also raises the no-suffix toolset default from read-only to camunda7
# operations / analytics standard (admin still has to be named), and enables
# the dashboard builder unless a module runs read-only. Auth terminated in a
# gateway or reverse proxy IN FRONT of the server is invisible to it: such a
# setup boots read-only unless MCP_ACTIVE_MODULES names the toolsets, and
# saves no settings (identity only ever comes from MCP_OAUTH, never a header).
# Exactly one of the two providers — the token audience is the server's
# canonical MCP URL (RFC 8707, MCP_URL), so there is no audience field; any
# other provider or key fails the boot:
# MCP_OAUTH={"provider":"keycloak","serverUrl":"https://kc.example.com","realm":"platform"}
# MCP_OAUTH={"provider":"auth0","domain":"tenant.eu.auth0.com"}
#
# Local playground: `docker compose --profile auth up -d` adds a Keycloak on
# host port 8480 (realm `miragon`, user demo/demo — seeded from
# playground/docker/keycloak/realm-miragon.json; admin console admin/admin).
# Point the server at it with the line below; MCP clients register with the
# IdP directly (Dynamic Client Registration — the seeded Trusted Hosts
# policy admits clients with loopback redirect URIs and rejects foreign
# hosts). The seeded realm stamps the required aud
# http://localhost:8400/mcp via the `mcp-resource` client scope (RFC 8707)
# and keeps the `sub` claim the provider requires via the seeded `basic`
# scope. Realm-file changes need `docker compose --profile auth up -d
# --force-recreate keycloak` to re-import.
# MCP_OAUTH={"provider":"keycloak","serverUrl":"http://localhost:8480","realm":"miragon"}

# ── Optional persistence & thresholds ──────────────────────────────────────
# Postgres persistence for BOTH user profiles and saved dashboards. Beats the
# MCP_*_DIR knobs below when set. The Compose stack publishes its Postgres on
# host port 8440 (database `miragon`; `miragon_test` is reserved for the
# opt-in `pnpm test:pg` suites).
# DATABASE_URL=postgres://miragon:miragon@localhost:8440/miragon
# Persist dashboards saved via `save-dashboard` across restarts (unset → in-memory).
# MCP_DASHBOARD_DIR=./.dashboards
# Persist user profiles (language, theme, engine availability + default,
# dashboard and analytics preferences) across restarts (unset → in-memory).
# MCP_PROFILE_DIR=./.profiles
# Engine-health verdict thresholds (defaults 50 / 25): "critical" at
# >= CRITICAL_INCIDENTS open incidents in total, or when a single failure
# cluster reaches >= CRITICAL_CLUSTER_SIZE incidents.
# CAMUNDA_HEALTH_CRITICAL_INCIDENTS=50
# CAMUNDA_HEALTH_CRITICAL_CLUSTER_SIZE=25
