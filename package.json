{
  "name": "pulse",
  "version": "0.21.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "scripts": {
    "generate": "turbo run generate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://miragon:miragon@localhost:8440/miragon_test} pnpm --fail-if-no-match --filter @miragon/pulse-widget-shell --filter @miragon/pulse-camunda7-connector --filter @miragon/pulse-mcp-server-camunda7 run test",
    "lint": "turbo run lint && pnpm lint:architecture && pnpm lint:architecture:cli && pnpm lint:naming && pnpm lint:package-scripts && pnpm lint:ratchets && pnpm lint:deadcode && pnpm lint:deadcode:cli && pnpm lint:github",
    "lint:architecture": "depcruise apps/*/src packages/core/*/src packages/connectors/*/*/src --config .dependency-cruiser.cjs",
    "lint:architecture:cli": "depcruise apps/cli/scripts apps/cli/test --config .dependency-cruiser.cjs",
    "lint:naming": "node scripts/check-package-naming.mjs",
    "lint:package-scripts": "node scripts/check-package-scripts.mjs",
    "lint:ratchets": "node scripts/check-ratchets.mjs",
    "lint:github": "node scripts/check-github-config.mjs",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev": "dotenv -e .env -- pnpm --fail-if-no-match --filter @miragon/pulse-mcp-server-camunda7 dev",
    "docs:dev": "pnpm --fail-if-no-match --filter @miragon/pulse-docs dev",
    "docs:build": "pnpm --fail-if-no-match --filter @miragon/pulse-docs build",
    "docs:preview": "pnpm --fail-if-no-match --filter @miragon/pulse-docs preview",
    "test:mutation": "node scripts/mutation-diff.mjs",
    "fitness": "node scripts/fitness-report.mjs",
    "lint:deadcode": "knip --exclude exports,types,enumMembers",
    "lint:deadcode:cli": "knip --workspace apps/cli"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.7.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "picomatch": "4.0.7",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
