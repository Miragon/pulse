{
  "name": "pulse-monorepo",
  "version": "0.27.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "scripts": {
    "generate": "turbo run generate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --continue=dependencies-successful && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "third-party-licenses": "pnpm -r --if-present run third-party-licenses",
    "lint": "pnpm lint:naming && pnpm lint:package-scripts && pnpm lint:github && pnpm lint:ratchets && turbo run lint --continue=dependencies-successful && pnpm lint:architecture && pnpm lint:architecture:cli && pnpm lint:architecture:vscode && pnpm lint:architecture:runtime-view && pnpm lint:architecture:c7-adapter && pnpm lint:architecture:orca && pnpm lint:deadcode && pnpm lint:deadcode:exports && pnpm lint:configs",
    "lint:architecture": "depcruise apps/*/src packages/core/*/src packages/connectors/*/*/src packages/core/*/test packages/connectors/*/*/test packages/connectors/*/*/scripts --config .dependency-cruiser.cjs --output-type err-long",
    "lint:architecture:cli": "depcruise apps/cli/scripts apps/cli/test --config .dependency-cruiser.cjs --output-type err-long",
    "lint:architecture:vscode": "depcruise apps/vscode/src apps/vscode/test apps/vscode/dev apps/vscode/scripts --config apps/vscode/.dependency-cruiser.cjs --output-type err-long",
    "lint:architecture:runtime-view": "depcruise packages/core/runtime-view/src packages/core/runtime-view/test packages/core/runtime-view/dev packages/core/runtime-view/scripts --config packages/core/runtime-view/.dependency-cruiser.cjs --output-type err-long",
    "lint:architecture:c7-adapter": "depcruise packages/connectors/c7/c7-adapter/src packages/connectors/c7/c7-adapter/test --config packages/connectors/c7/c7-adapter/.dependency-cruiser.cjs --output-type err-long",
    "lint:architecture:orca": "depcruise apps/orca/src apps/orca/test apps/orca/scripts --config apps/orca/.dependency-cruiser.cjs --output-type err-long",
    "lint:naming": "node scripts/check-package-naming.mjs",
    "lint:package-scripts": "node scripts/check-package-scripts.mjs",
    "lint:ratchets": "node scripts/check-ratchets.mjs",
    "lint:github": "node scripts/check-github-config.mjs",
    "lint:configs": "node scripts/lint-configs.mjs",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev": "dotenv -e .env -- pnpm --fail-if-no-match --filter @miragon/pulse-mcp-server dev",
    "play": "node scripts/local.mjs play",
    "play:cli": "node scripts/local.mjs play:cli",
    "test:one": "node scripts/local.mjs test:one",
    "stack:up": "node scripts/local.mjs stack:up",
    "stack:down": "node scripts/local.mjs stack:down",
    "stack:status": "node scripts/local.mjs stack:status",
    "check": "node scripts/local.mjs check",
    "check:all": "node scripts/local.mjs check:all",
    "docs:dev": "pnpm --fail-if-no-match --filter @miragon/pulse-docs dev",
    "docs:build": "pnpm --fail-if-no-match --filter @miragon/pulse-docs build",
    "docs:preview": "pnpm --fail-if-no-match --filter @miragon/pulse-docs preview",
    "fitness": "node scripts/fitness-report.mjs",
    "lint:deadcode": "knip --exclude exports,types",
    "lint:deadcode:exports": "knip --workspace '!docs' --include exports,types"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "dotenv-cli": "11.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "knip": "6.44.2",
    "lint-staged": "17.6.0",
    "picomatch": "4.0.7",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
