node_modules/
dist/
.turbo/
coverage/
*.tsbuildinfo
# Local credentials, in every package, never in the image or the repo.
# `.env.example` is the committed template.
**/.env*
!**/.env.example
# Local profile records of the removed profile store, keyed by user id or
# e-mail: a checkout may still hold them, so never commit or ship them.
**/.profiles
**/.data
# The template ships without a lockfile: customers generate and commit their
# own after copying it out (its Dockerfile expects one).
templates/composed-server/pnpm-lock.yaml
miranum-ai/
# Gradle
playground/cibseven-example/.gradle/
playground/cibseven-example/build/
.idea/
.playwright-mcp/
.ai/
.DS_STORE
.claude/scheduled_tasks.lock
.claude/logs/
# Playwright host-simulation output
apps/mcp-server/test-results/
.stryker-tmp/
reports/
stryker-setup-*.js
# The one Camunda 7 REST spec with its patches applied, which c7-core's `generate` writes for
# c7-client's SDK and the CLI's catalog: derived, so never committed and never shipped.
packages/connectors/c7/c7-core/spec/patched/
# The CLI (apps/cli): the standalone bundle and executables (build:standalone, build:exe), a
# packed tarball and the results of a local plugin eval run.
apps/cli/build/
apps/cli/*.tgz
apps/cli/skills/pulse-cli/evals/results/

# The VS Code extension (apps/vscode): the VS Code that @vscode/test-cli and the e2e
# scripts download, packaged extensions, the browser dev host's build, the e2e
# screenshots, and vitest browser mode's failure screenshots and attachments
.vscode-test/
*.vsix
apps/vscode/dist-dev/
apps/vscode/test-results/
__screenshots__/
.vitest/
# check-ratchets.mjs: the temporary eslint.config.mjs copies an interrupted run leaves behind
.check-ratchets-*.eslint.mjs
