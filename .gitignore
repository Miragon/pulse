*.tsbuildinfo
# Local credentials and dev persistence (MCP_PROFILE_DIR / MCP_DASHBOARD_DIR
# records are keyed by user id or e-mail) — in every package, never in the
# image or the repo. `.env.example` is the committed template.
**/.env*
!**/.env.example
**/.profiles
**/.dashboards
**/.data
# The template ships without a lockfile — customers generate and commit their
# own after copying it out (its Dockerfile expects one).
templates/composed-server/pnpm-lock.yaml
miranum-ai/
# Gradle
engine-plugins/.gradle/
engine-plugins/build/
engine-plugins/*/build/
playground/cibseven-example/.gradle/
playground/cibseven-example/build/
.idea/
.mcp-use/
# Generated by `mcp-use dev`/`mcp-use build` next to the server entry
# (mcp-use/react typing sugar); regenerated on every run, not needed by CI.
mcp-env.d.ts
.playwright-mcp/
.ai/
.DS_STORE
.claude/scheduled_tasks.lock
.claude/logs/
# Playwright host-simulation output
apps/mcp-server-camunda7/test-results/
.stryker-tmp/
reports/
stryker-setup-*.js
# The VS Code extension (apps/vscode): the VS Code that @vscode/test-cli and the e2e
# scripts download, packaged extensions, the browser dev host's build, the e2e
# screenshots, and vitest browser mode's failure screenshots and attachments
.vscode-test/
*.vsix
apps/vscode/dist-dev/
apps/vscode/test-results/
__screenshots__/
.vitest/
